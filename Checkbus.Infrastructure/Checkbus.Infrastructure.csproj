<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets integration tests bind a fixed tenant via the internal CheckbusDbContext.BindTenant
         (D4/D9) without widening it to a public API. -->
    <InternalsVisibleTo Include="Checkbus.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Checkbus.Application\Checkbus.Application.csproj" />
    <ProjectReference Include="..\Checkbus.Domain\Checkbus.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="8.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="8.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
  </ItemGroup>

</Project>
