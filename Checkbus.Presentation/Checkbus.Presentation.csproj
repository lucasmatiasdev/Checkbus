<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>0097e834-dadb-4e32-8128-246114c42f80</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets Checkbus.UnitTests reference the compiler-generated internal Program class via
         WebApplicationFactory<Program> for the Development-gate integration test. -->
    <InternalsVisibleTo Include="Checkbus.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Checkbus.Application\Checkbus.Application.csproj" />
    <ProjectReference Include="..\Checkbus.Domain\Checkbus.Domain.csproj" />
    <ProjectReference Include="..\Checkbus.Infrastructure\Checkbus.Infrastructure.csproj" />
  </ItemGroup>

</Project>
