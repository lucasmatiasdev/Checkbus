@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject Checkbus.Presentation.Authentication.CircuitCurrentTenant CircuitCurrentTenant

<MudThemeProvider Theme="CheckbusTheme.Default" IsDarkMode="true" />

<AuthorizeView>
    <Authorized>
        <Sidebar />
    </Authorized>
</AuthorizeView>

<div class="checkbus-main">
    @Body
</div>

<InteractiveShell />

@code {
    protected override async Task OnInitializedAsync()
    {
        await CircuitCurrentTenant.PrimeAsync();
    }
}
