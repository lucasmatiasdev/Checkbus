@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager
@inject Checkbus.Application.Abstractions.ICurrentTenant CurrentTenant
@inject Checkbus.Presentation.Authentication.CircuitCurrentTenant CircuitCurrentTenant

<MudDrawer Open="true" Variant="DrawerVariant.Persistent" Anchor="Anchor.Left">
    <MudDrawerHeader>
        <MudText Typo="Typo.h6">@CurrentTenant.OrganizationName</MudText>
    </MudDrawerHeader>
    <div class="checkbus-sidebar__stack">
        <MudNavMenu>
            <MudNavLink Href="/dashboard" Match="NavLinkMatch.Prefix">Dashboard</MudNavLink>
        </MudNavMenu>
        <div class="checkbus-sidebar__footer">
            <AuthorizeView>
                <Authorized>
                    <MudText>@context.User.Identity?.Name</MudText>
                    <MudButton OnClick="@(() => NavigationManager.NavigateTo("/Account/Logout", forceLoad: true))">Cerrar sesión</MudButton>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</MudDrawer>

@code {
    protected override async Task OnInitializedAsync()
    {
        // D-SN3: the circuit is a different DI scope from the static SSR request that rendered
        // MainLayout, and island initialization order is not guaranteed, so Sidebar primes
        // CircuitCurrentTenant itself rather than depending on InteractiveShell having run.
        await CircuitCurrentTenant.PrimeAsync();
    }
}
