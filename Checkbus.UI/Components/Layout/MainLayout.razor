@inherits LayoutComponentBase
@using Checkbus.BEL.Auth
@using Checkbus.BLL.Tenancy
@using Microsoft.AspNetCore.Components.Authorization
@inject CircuitTenantState CircuitTenantState

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">CheckBus</MudText>
        <MudSpacer />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="@DrawerVariant.Mini" OpenMiniOnHover="true">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // Populates the CircuitTenantState fallback once per circuit, from the
    // cascading AuthenticationState (captured once at circuit start and
    // reliable across later interactive renders, unlike IHttpContextAccessor
    // — see CircuitTenantState/HttpContextTenantProvider). Any authenticated
    // page under this layout that triggers a tenant-scoped BLL call from a
    // component event (@onclick, EditForm OnValidSubmit, etc.) needs this.
    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var state = await AuthenticationStateTask;
            var claimValue = state.User?.FindFirst(CheckbusClaimTypes.OrganizationId)?.Value;
            var organizationId = claimValue is not null && int.TryParse(claimValue, out var parsed) ? parsed : (int?)null;
            CircuitTenantState.Capture(organizationId);
        }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
