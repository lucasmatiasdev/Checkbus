@page "/empresas/nueva"

<PageTitle>Dar de alta una empresa</PageTitle>

<h1>Dar de alta una empresa</h1>

@if (HttpContext.Request.Query.ContainsKey("error"))
{
    <p class="text-danger">
        No se pudo registrar la empresa. Verificá que el CUIT y el correo electrónico del administrador no estén ya en uso.
    </p>
}

<form method="post" action="/account/register-company">
    <h2>Datos de la empresa</h2>
    <div class="mb-3">
        <label for="organizationName">Razón social</label>
        <input type="text" id="organizationName" name="organizationName" class="form-control" required />
    </div>
    <div class="mb-3">
        <label for="cuit">CUIT</label>
        <input type="text" id="cuit" name="cuit" class="form-control" required />
    </div>

    <h2>Usuario administrador inicial</h2>
    <div class="mb-3">
        <label for="adminFullName">Nombre completo</label>
        <input type="text" id="adminFullName" name="adminFullName" class="form-control" required />
    </div>
    <div class="mb-3">
        <label for="adminEmail">Correo electrónico</label>
        <input type="email" id="adminEmail" name="adminEmail" class="form-control" required />
    </div>
    <div class="mb-3">
        <label for="adminPassword">Contraseña</label>
        <input type="password" id="adminPassword" name="adminPassword" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">Registrar empresa</button>
</form>

<p class="mt-3">¿Ya tenés una cuenta? <a href="/login">Iniciar sesión</a>.</p>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
}
