@page "/app/drivers/new"
@using Checkbus.BEL.Fleet.Enums
@using Checkbus.BLL.Fleet
@using Checkbus.BLL.Tenancy
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IFleetService FleetService
@inject CircuitTenantState CircuitTenantState
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Nuevo chofer</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Nuevo chofer</MudText>

<MudCard Class="pa-4" Style="max-width: 560px;">
    <MudCardContent>
        <MudForm @ref="_form" Model="_model">
            <MudTextField T="string" Label="Nombre completo" @bind-Value="_model.FullName"
                          Required="true" RequiredError="Campo obligatorio" Class="mb-3" />
            <MudTextField T="string" Label="DNI" @bind-Value="_model.Dni"
                          Required="true" RequiredError="Campo obligatorio" Class="mb-3" />
            <MudSelect T="LicenseCategory" Label="Categoría de licencia" @bind-Value="_model.LicenseCategory" Class="mb-3">
                @foreach (var category in Enum.GetValues<LicenseCategory>())
                {
                    <MudSelectItem T="LicenseCategory" Value="category">@category</MudSelectItem>
                }
            </MudSelect>
            <MudDatePicker Label="Vencimiento de la licencia" @bind-Date="_licenseExpiryDate" Class="mb-3" />
            <InputFile OnChange="OnLicenseFileSelected" />
            @if (_licenseFileName is not null)
            {
                <MudText Typo="Typo.body2" Class="mt-1">Archivo seleccionado: @_licenseFileName</MudText>
            }
        </MudForm>

        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
        }
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving">Guardar</MudButton>
    </MudCardActions>
</MudCard>

@code {
    private const long MaxUploadBytes = 10 * 1024 * 1024;

    private MudForm _form = null!;
    private readonly DriverFormModel _model = new();
    private DateTime? _licenseExpiryDate = DateTime.UtcNow.AddYears(1);
    private IBrowserFile? _licenseFile;
    private string? _licenseFileName;
    private bool _saving;
    private string? _errorMessage;

    private void OnLicenseFileSelected(InputFileChangeEventArgs e)
    {
        _licenseFile = e.File;
        _licenseFileName = e.File.Name;
    }

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        var organizationId = CircuitTenantState.OrganizationId;
        if (organizationId is null)
        {
            _errorMessage = "No se pudo determinar la organización actual.";
            return;
        }

        _saving = true;
        _errorMessage = null;
        try
        {
            FileUpload? licenseDocument = null;
            if (_licenseFile is not null)
            {
                var stream = _licenseFile.OpenReadStream(MaxUploadBytes);
                var format = Path.GetExtension(_licenseFile.Name).TrimStart('.');
                licenseDocument = new FileUpload(_licenseFile.Name, format, stream);
            }

            await FleetService.CreateDriverAsync(
                organizationId.Value, _model.FullName, _model.Dni, _model.LicenseCategory,
                _licenseExpiryDate ?? DateTime.UtcNow, licenseDocument);

            Snackbar.Add("Chofer creado correctamente.", Severity.Success);
            NavigationManager.NavigateTo("/app");
        }
        catch (Exception ex)
        {
            _errorMessage = "No se pudo crear el chofer: " + ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private class DriverFormModel
    {
        public string FullName { get; set; } = string.Empty;
        public string Dni { get; set; } = string.Empty;
        public LicenseCategory LicenseCategory { get; set; } = LicenseCategory.B1;
    }
}
