@page "/"
@using Checkbus.BEL.Auth
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Home</PageTitle>

@if (currentUser?.Identity?.IsAuthenticated == true)
{
    <h1>Hola, @currentUser.Identity!.Name</h1>
    <p>Organización actual: @currentUser.FindFirst(CheckbusClaimTypes.OrganizationId)?.Value</p>
    <form method="post" action="/account/logout">
        <button type="submit" class="btn btn-secondary">Cerrar sesión</button>
    </form>
}
else
{
    <h1>Checkbus</h1>
    <p>
        <a href="/login">Iniciar sesión</a> o
        <a href="/empresas/nueva">dar de alta una empresa</a>.
    </p>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private System.Security.Claims.ClaimsPrincipal? currentUser;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var state = await AuthenticationStateTask;
            currentUser = state.User;
        }
    }
}
