@page "/login"

<PageTitle>Iniciar sesión</PageTitle>

<h1>Iniciar sesión</h1>

@if (_hasError)
{
    <p class="text-danger">Correo electrónico o contraseña incorrectos.</p>
}

<form method="post" action="/account/login">
    <div class="mb-3">
        <label for="email">Correo electrónico</label>
        <input type="email" id="email" name="email" class="form-control" required autofocus />
    </div>
    <div class="mb-3">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Ingresar</button>
</form>

<p class="mt-3">
    ¿Todavía no tenés una empresa registrada?
    <a href="/empresas/nueva">Dar de alta una empresa</a>.
</p>

@code {
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private bool _hasError;

    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(new Uri(NavigationManager.Uri).Query);
        _hasError = query.ContainsKey("error");
    }
}
