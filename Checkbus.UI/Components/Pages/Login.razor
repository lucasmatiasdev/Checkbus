@page "/login"
@layout Layout.MarketingLayout

<PageTitle>Iniciar sesión</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex justify-center" Style="min-height: 80vh; align-items: center;">
    <MudCard Elevation="4" Class="pa-4" Style="width: 100%; max-width: 420px;">
        <MudCardContent>
            <MudText Typo="Typo.h5" Class="mb-1">Iniciar sesión</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Ingresá con tu cuenta de Checkbus</MudText>

            @if (_hasError)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">Correo electrónico o contraseña incorrectos.</MudAlert>
            }

            <form method="post" action="/account/login">
                <AntiforgeryToken />
                <MudTextField T="string"
                              Label="Correo electrónico"
                              InputType="InputType.Email"
                              Required="true"
                              Class="mb-4"
                              UserAttributes="@(new Dictionary<string, object> { ["name"] = "email", ["autofocus"] = true })" />

                <MudTextField T="string"
                              Label="Contraseña"
                              InputType="InputType.Password"
                              Required="true"
                              Class="mb-4"
                              UserAttributes="@(new Dictionary<string, object> { ["name"] = "password" })" />

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">
                    Ingresar
                </MudButton>
            </form>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private bool _hasError;

    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(new Uri(NavigationManager.Uri).Query);
        _hasError = query.ContainsKey("error");
    }
}
