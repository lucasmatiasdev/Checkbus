<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Organización creada</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-4">
            <strong>@OrganizationName</strong> fue creada con slug <strong>@Slug</strong>. Compartí estas
            credenciales con <strong>@AdminName @AdminSurname</strong> para que pueda iniciar sesión.
        </MudText>

        <MudStack Spacing="2" Class="mb-4">
            <MudTextField T="string" Label="Organización" Value="@OrganizationName" ReadOnly="true" Variant="Variant.Outlined" />
            <MudTextField T="string" Label="Slug" Value="@Slug" ReadOnly="true" Variant="Variant.Outlined" />
            <MudTextField T="string" Label="Email del administrador" Value="@AdminEmail" ReadOnly="true" Variant="Variant.Outlined" />
            <MudTextField T="string" Label="Contraseña inicial" Value="@InitialPassword" ReadOnly="true" Variant="Variant.Outlined" />
        </MudStack>

        <MudAlert Severity="Severity.Warning">
            Es obligatorio que la persona cambie esta contraseña la primera vez que inicie sesión.
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public required string OrganizationName { get; set; }

    [Parameter]
    public required string Slug { get; set; }

    [Parameter]
    public required string AdminEmail { get; set; }

    [Parameter]
    public required string AdminName { get; set; }

    [Parameter]
    public required string AdminSurname { get; set; }

    [Parameter]
    public required string InitialPassword { get; set; }

    private void Close()
    {
        MudDialog.Close();
    }
}
