@inherits LayoutComponentBase

<MudThemeProvider Theme="CheckbusTheme.Instance" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
    </MudAppBar>
    <MudDrawer @bind-Open="@_drawerOpen" Variant="DrawerVariant.Responsive" Elevation="1">
        <MudDrawerHeader>
            <MudNavLink Href="/dashboard" Match="NavLinkMatch.All">
                <MudText Typo="Typo.h6">Checkbus</MudText>
            </MudNavLink>          
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Href="/dashboard" Match="NavLinkMatch.All">
                <MudIcon Icon="@Icons.Material.Filled.Home" />
                Home
            </MudNavLink>
            <AuthorizeView Roles="Administrador">
                <MudNavLink Href="/users" Match="NavLinkMatch.All">
                    <MudIcon Icon="@Icons.Material.Filled.People" />
                    Usuarios
                </MudNavLink>
                <MudNavLink Href="/vehicles" Match="NavLinkMatch.All">
                    <MudIcon Icon="@Icons.Material.Filled.DirectionsBus" />
                    Vehículos
                </MudNavLink>
            </AuthorizeView>
            <AuthorizeView Roles="Chofer">
                <MudNavLink Href="/my-documents" Match="NavLinkMatch.All">
                    <MudIcon Icon="@Icons.Material.Filled.FolderShared" />
                    Mis Documentos
                </MudNavLink>
            </AuthorizeView>
            <AuthorizeView Roles="Mecanico,Administrador">
                <MudNavLink Href="/maintenance" Match="NavLinkMatch.All">
                    <MudIcon Icon="@Icons.Material.Filled.Build" />
                    Mantenimiento
                </MudNavLink>
            </AuthorizeView>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}