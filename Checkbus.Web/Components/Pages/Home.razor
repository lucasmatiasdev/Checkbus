@page "/"
@layout LandingLayout

<PageTitle>Checkbus</PageTitle>

<!-- Hero section: navbar's #producto link resolves here. -->
<MudContainer id="producto" MaxWidth="MaxWidth.Large" Class="py-16 d-flex flex-column align-center text-center">
    <MudText Typo="Typo.h2" Color="Color.Secondary" Class="font-weight-bold mb-4">Checkbus</MudText>
    <MudText Typo="Typo.h5" Color="Color.Secondary" Class="mb-6">
        La plataforma que digitaliza la operación de tu empresa de transporte de pasajeros.
    </MudText>
    <MudButton Href="#precios" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" DropShadow="false">
        Ver planes
    </MudButton>
</MudContainer>

<!-- Trust bar section (#confianza): Microsoft/Visual Studio/C#/.NET as text-only wordmarks
     (binding trademark constraint — see TechBadge.razor), GitHub/PostgreSQL as isolated logo
     cards, never merged into one flat row. -->
<MudContainer id="confianza" MaxWidth="MaxWidth.Large" Class="py-12">
    <MudText Typo="Typo.overline" Align="Align.Center" Class="d-block mb-6">
        Construido sobre tecnología estándar
    </MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.Center" Spacing="6">
        <TechBadge Label="Microsoft" />
        <TechBadge Label="Visual Studio" />
        <TechBadge Label="C#" />
        <TechBadge Label=".NET" />
    </MudStack>
    <MudDivider Class="my-8" />
    <MudGrid Justify="Justify.Center" Spacing="8">
        <MudItem xs="12" md="5">
            <BrandLogoCard Src="@Assets["img/brand/github-mark.svg"]"
                           Alt="GitHub"
                           Caption="GitHub®. Marca registrada de GitHub, Inc." />
        </MudItem>
        <MudItem xs="0" md="2" Class="d-none d-md-block"></MudItem>
        <MudItem xs="12" md="5">
            <BrandLogoCard Src="@Assets["img/brand/postgresql-elephant.svg"]"
                           Alt="PostgreSQL"
                           Caption="PostgreSQL®. Marca registrada de la PostgreSQL Community Association of Canada." />
        </MudItem>
    </MudGrid>
</MudContainer>

<!-- Soluciones section: navbar's #soluciones link resolves here. -->
<MudContainer id="soluciones" MaxWidth="MaxWidth.Large" Class="py-12">
    <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-8">Soluciones</MudText>
    <MudGrid>
        @foreach (var solution in LandingContent.Solutions)
        {
            <MudItem xs="12" sm="6" md="3">
                <SolutionCard Item="solution" />
            </MudItem>
        }
    </MudGrid>
</MudContainer>

<!-- Precios section: navbar's #precios link resolves here. Exactly 3 static plans
     (LandingContent.Plans.Count is unit-tested). -->
<MudContainer id="precios" MaxWidth="MaxWidth.Large" Class="py-12">
    <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-8">Precios</MudText>
    <MudGrid Justify="Justify.Center">
        @foreach (var plan in LandingContent.Plans)
        {
            <MudItem xs="12" sm="6" md="4">
                <PricingCard Plan="plan" />
            </MudItem>
        }
    </MudGrid>
</MudContainer>

<!-- Testimonios section. -->
<MudContainer id="testimonios" MaxWidth="MaxWidth.Large" Class="py-12">
    <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-8">Testimonios</MudText>
    <MudGrid>
        @foreach (var testimonial in LandingContent.Testimonials)
        {
            <MudItem xs="12" md="4">
                <TestimonialCard Testimonial="testimonial" />
            </MudItem>
        }
    </MudGrid>
</MudContainer>

<!-- Contacto section: navbar's #contacto link resolves here. Display-only — a mailto: link,
     no form and no backend endpoint. -->
<MudContainer id="contacto" MaxWidth="MaxWidth.Large" Class="py-12 d-flex flex-column align-center text-center">
    <MudText Typo="Typo.h4" Class="mb-4">Contacto</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
        ¿Tienes preguntas? Escríbenos y te responderemos a la brevedad.
    </MudText>
    <MudButton Href="@($"mailto:{LandingContent.ContactEmail}")"
               Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Email"
               DropShadow="false">
        @LandingContent.ContactEmail
    </MudButton>
</MudContainer>

<!-- Footer: copyright, quick links to the same 4 navbar anchors, social icons, and contact
     info identical in content to the Contacto section above. -->
<MudContainer MaxWidth="MaxWidth.False" Class="py-8 mt-8" Style="background-color: var(--mud-palette-background-gray);">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudGrid Justify="Justify.SpaceBetween">
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.h6" Color="Color.Secondary" Class="font-weight-bold mb-2">Checkbus</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    &copy; @DateTime.UtcNow.Year Checkbus. Todos los derechos reservados.
                </MudText>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Enlaces</MudText>
                <MudStack Spacing="1">
                    <MudLink Href="#producto" Color="Color.Secondary" Underline="Underline.None">Producto</MudLink>
                    <MudLink Href="#soluciones" Color="Color.Secondary" Underline="Underline.None">Soluciones</MudLink>
                    <MudLink Href="#precios" Color="Color.Secondary" Underline="Underline.None">Precios</MudLink>
                    <MudLink Href="#contacto" Color="Color.Secondary" Underline="Underline.None">Contacto</MudLink>
                </MudStack>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Contacto</MudText>
                <MudLink Href="@($"mailto:{LandingContent.ContactEmail}")" Color="Color.Secondary" Underline="Underline.None" Class="d-block mb-3">
                    @LandingContent.ContactEmail
                </MudLink>
                <MudStack Row="true" Spacing="2">
                    <MudIconButton Icon="@Icons.Custom.Brands.Facebook" Color="Color.Secondary" Href="https://facebook.com" Target="_blank" aria-label="Facebook" />
                    <MudIconButton Icon="@Icons.Custom.Brands.Twitter" Color="Color.Secondary" Href="https://twitter.com" Target="_blank" aria-label="Twitter" />
                    <MudIconButton Icon="@Icons.Custom.Brands.LinkedIn" Color="Color.Secondary" Href="https://linkedin.com" Target="_blank" aria-label="LinkedIn" />
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudContainer>
</MudContainer>
