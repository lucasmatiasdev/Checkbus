@page "/reservas/confirmacion/{reservationIds}"
@layout LandingLayout
@attribute [AllowAnonymous]
@using Checkbus.Web.Features.PublicReservations.Contracts
@using Checkbus.Web.Features.PublicReservations.Services
@* This .razor file's own generated page class is also named "ReservationConfirmation" (same
   convention Blazor always uses: file name -> class name), which shadows the contract record
   of the same name from the Contracts namespace above — the alias below disambiguates every
   explicit reference to the DTO in this file's @code block. *@
@using ReservationConfirmationDto = Checkbus.Web.Features.PublicReservations.Contracts.ReservationConfirmation

<PageTitle>Checkbus - Confirmación de reserva</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Class="my-4" />
    }
    else if (notFound)
    {
        <!-- Covers both "no valid guid in the route at all" and the API's own 404 (none of
             the submitted ids resolved to a real Reservation) — same read-only, no-crash
             requirement either way. -->
        <MudAlert Severity="Severity.Error">No encontramos esa reserva.</MudAlert>
    }
    else if (errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }
    else if (confirmation is not null)
    {
        <MudText Typo="Typo.h4" Color="Color.Secondary" Class="font-weight-bold mb-4">
            Confirmación de reserva
        </MudText>

        @foreach (var reservation in displayedReservations.OrderBy(r => r.SeatNumber))
        {
            <MudPaper Elevation="2" Class="pa-6 mb-4">
                <MudText Typo="Typo.h6" Class="mb-2">@reservation.EventName</MudText>
                <MudText Typo="Typo.body2" Class="mb-4">
                    Salida: @reservation.DepartureDate.ToString("dd/MM/yyyy HH:mm")
                </MudText>

                <MudGrid>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Asiento</MudText>
                        <MudText Typo="Typo.body1">@reservation.SeatNumber</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Estado</MudText>
                        <MudText Typo="Typo.body1">@GetStatusLabel(reservation.Status)</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Pasajero</MudText>
                        <MudText Typo="Typo.body1">@reservation.PassengerName @reservation.PassengerSurname</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Documento</MudText>
                        <MudText Typo="Typo.body1">@reservation.PassengerDocumentType @reservation.PassengerDocumentNumber</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Precio</MudText>
                        <MudText Typo="Typo.body1">@reservation.Price.ToString("C")</MudText>
                    </MudItem>
                </MudGrid>

                @if (CanCancel(reservation.Status))
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               Class="mt-4"
                               Disabled="@cancellingReservationIds.Contains(reservation.ReservationId)"
                               OnClick="@(() => HandleCancelAsync(reservation))">
                        Cancelar reserva
                    </MudButton>
                }

                @if (rowErrorsByReservationId.TryGetValue(reservation.ReservationId, out var rowError))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2">@rowError</MudAlert>
                }
            </MudPaper>
        }
    }
</MudContainer>

@code {
    [Parameter]
    public string ReservationIds { get; set; } = string.Empty;

    [Inject]
    private PublicReservationsClient PublicReservationsClient { get; set; } = default!;

    [Inject]
    private IDialogService DialogService { get; set; } = default!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = default!;

    // Reservation.Status is exposed as a plain string by the API (see
    // ReservationsConfirmationResponse's doc comment) — this page only ever compares against
    // these literals, matching the server's HasConversion<string>() representation.
    private const string CanceladaStatus = "Cancelada";
    private const string ConfirmadaStatus = "Confirmada";
    private const string PendientePagoStatus = "PendientePago";

    private ReservationsConfirmationResponse? confirmation;

    // Mutable local copy of confirmation.Reservations (itself an IReadOnlyList<record> with
    // init-only properties) so a successful cancel can flip just that one row's displayed
    // Status in place — same "flip the one field that changed" precedent R2's TripDetail.razor
    // used — without a full page reload/refetch.
    private List<ReservationConfirmationDto> displayedReservations = [];

    private readonly HashSet<Guid> cancellingReservationIds = [];
    private readonly Dictionary<Guid, string> rowErrorsByReservationId = [];

    private bool isLoading = true;
    private bool notFound;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var ids = ParseReservationIds(ReservationIds);
        if (ids.Count == 0)
        {
            // No valid GUID in the route segment at all — same user-facing message as the
            // API's own "none resolved" 404, no separate error state needed.
            notFound = true;
            isLoading = false;
            return;
        }

        try
        {
            var outcome = await PublicReservationsClient.GetConfirmationAsync(ids);

            switch (outcome)
            {
                case ReservationsConfirmationOutcome.Success success:
                    confirmation = success.Confirmation;
                    displayedReservations = confirmation.Reservations.ToList();
                    break;

                case ReservationsConfirmationOutcome.NotFound:
                    notFound = true;
                    break;

                case ReservationsConfirmationOutcome.TransportError transportError:
                    errorMessage = transportError.Message;
                    break;
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleCancelAsync(ReservationConfirmationDto reservation)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Cancelar reserva",
            "Esta acción cancela tu reserva y libera el asiento. No se puede deshacer. ¿Confirmás?",
            yesText: "Cancelar reserva",
            cancelText: "Volver");

        if (confirmed != true)
        {
            return;
        }

        rowErrorsByReservationId.Remove(reservation.ReservationId);
        cancellingReservationIds.Add(reservation.ReservationId);
        try
        {
            var outcome = await PublicReservationsClient.CancelReservationAsync(reservation.ReservationId);

            switch (outcome)
            {
                case CancelReservationOutcome.Success:
                    var index = displayedReservations.FindIndex(r => r.ReservationId == reservation.ReservationId);
                    if (index >= 0)
                    {
                        displayedReservations[index] = displayedReservations[index] with { Status = CanceladaStatus };
                    }

                    Snackbar.Add("Reserva cancelada.", Severity.Success);
                    break;

                case CancelReservationOutcome.NotCancellable notCancellable:
                    // Row-specific, not a page-level alert: the reason ("ya abordó" / "faltan
                    // menos de 24hs") is only meaningful next to the reservation it blocks.
                    rowErrorsByReservationId[reservation.ReservationId] = notCancellable.Message;
                    break;

                case CancelReservationOutcome.NotFound:
                    rowErrorsByReservationId[reservation.ReservationId] = "No encontramos esa reserva.";
                    break;

                case CancelReservationOutcome.TransportError transportError:
                    rowErrorsByReservationId[reservation.ReservationId] = transportError.Message;
                    break;
            }
        }
        finally
        {
            cancellingReservationIds.Remove(reservation.ReservationId);
        }
    }

    // Added in odd/tasks/pagos-mercadopago.md Fase C2: a PendientePago row is a payment-pending
    // hold, not an actual booking yet — offering to "cancel" it here would be a different,
    // unscoped operation (CancelReservationCommandHandler only knows how to cancel a
    // Confirmada reservation). Public and static (not private) specifically so this pure logic
    // is unit-testable without bUnit, which this repo does not have (see
    // RegisterUserPageAuthorizationTests's own doc comment for that same constraint).
    public static bool CanCancel(string status) => status == ConfirmadaStatus;

    // Plain-string status values coming straight off the server (see the field's own doc
    // comment above) rendered as short, buyer-facing Spanish labels instead of the raw enum
    // name — "PendientePago" read literally would be confusing to a non-technical visitor.
    // Falls back to the raw value for anything unrecognized rather than hiding it.
    public static string GetStatusLabel(string status) => status switch
    {
        ConfirmadaStatus => "Confirmada",
        PendientePagoStatus => "Pendiente de pago",
        CanceladaStatus => "Cancelada",
        _ => status
    };

    // The route segment is a comma-separated list of Reservation ids (the small batch
    // returned together by one R4 submission) — any entry that isn't a valid GUID is
    // dropped rather than failing the whole page, same "omit, don't error" posture as the
    // API handler.
    private static List<Guid> ParseReservationIds(string raw)
    {
        var ids = new List<Guid>();
        foreach (var segment in raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (Guid.TryParse(segment, out var id))
            {
                ids.Add(id);
            }
        }

        return ids;
    }
}
