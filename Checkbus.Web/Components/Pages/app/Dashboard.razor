@page "/dashboard"
@attribute [Authorize]
@using Checkbus.Web.Contracts
@using Checkbus.Web.Services

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <h3>Dashboard</h3>

    @if (currentUser is not null)
    {
        <MudText Typo="Typo.body1">Usuario: @currentUser.Email</MudText>
        <MudText Typo="Typo.body1">Rol: @currentUser.Role</MudText>
        <MudText Typo="Typo.body1">Organización: @currentUser.OrganizationId</MudText>
    }

    @if (isAdministrador)
    {
        <MudGrid Class="mt-4">
            <MudItem xs="3">
                <MudPaper Elevation="2"
                          Class="pa-4"
                          Style="cursor: pointer;"
                          @onclick="@(() => NavigationManager.NavigateTo("/users"))">
                    @if (isLoadingExpiringCount)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                    }
                    else if (expiringCount is not null)
                    {
                        <MudText Typo="Typo.h4">@expiringCount</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.h4">—</MudText>
                    }
                    <MudText Typo="Typo.body2">
                        @(expiringCount is null && !isLoadingExpiringCount ? "No disponible" : "Documentos por vencer")
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="3">
                <MudPaper Elevation="2"
                          Class="pa-4"
                          Style="cursor: pointer;"
                          @onclick="@(() => NavigationManager.NavigateTo("/vehicles"))">
                    @if (isLoadingVehicleExpiringCount)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                    }
                    else if (vehicleExpiringCount is not null)
                    {
                        <MudText Typo="Typo.h4">@vehicleExpiringCount</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.h4">—</MudText>
                    }
                    <MudText Typo="Typo.body2">
                        @(vehicleExpiringCount is null && !isLoadingVehicleExpiringCount ? "No disponible" : "Documentos de vehículos por vencer")
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }

    <form method="post" action="/logout" data-enhance="false">
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary">
            Cerrar sesión
        </MudButton>
    </form>
</MudContainer>

@code {
    // Resolved via IServiceProvider.GetRequiredKeyedService, not IHttpClientFactory.CreateClient:
    // the Application Scope Handler pattern (Phase 5) only attaches the bearer token when the
    // HttpClient is obtained through the keyed-scoped registration created by
    // AddApplicationScopeHandler(), so the request carries the circuit's IServiceProvider for
    // AuthenticationStateHandler to read the "access_token" claim from.
    [Inject]
    private IServiceProvider ServiceProvider { get; set; } = default!;

    [Inject]
    private DriverRequirementsClient DriverRequirementsClient { get; set; } = default!;

    [Inject]
    private VehicleDocumentsClient VehicleDocumentsClient { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private CurrentUserResponse? currentUser;
    private bool isAdministrador;
    private int? expiringCount;
    private bool isLoadingExpiringCount;
    private int? vehicleExpiringCount;
    private bool isLoadingVehicleExpiringCount;

    protected override async Task OnInitializedAsync()
    {
        var httpClient = ServiceProvider.GetRequiredKeyedService<HttpClient>("apiservice");
        currentUser = await httpClient.GetFromJsonAsync<CurrentUserResponse>("auth/me");
        isAdministrador = currentUser?.Role == "Administrador";

        if (isAdministrador)
        {
            isLoadingExpiringCount = true;
            isLoadingVehicleExpiringCount = true;
            // OnInitializedAsync only re-renders once, after the whole method completes — without
            // this explicit StateHasChanged, isAdministrador becoming true and the spinners turning
            // on would never reach the DOM before the count fetches below also finish.
            StateHasChanged();
            try
            {
                var outcome = await DriverRequirementsClient.GetExpiringCountAsync();
                expiringCount = outcome switch
                {
                    DriverRequirementCountOutcome.Success success => success.Count,
                    _ => null
                };
            }
            finally
            {
                isLoadingExpiringCount = false;
            }

            try
            {
                // Independent card and independent count from the driver-requirements one above —
                // explicit user decision, never summed into a single combined number.
                var vehicleOutcome = await VehicleDocumentsClient.GetExpiringCountAsync();
                vehicleExpiringCount = vehicleOutcome switch
                {
                    VehicleDocumentCountOutcome.Success success => success.Count,
                    _ => null
                };
            }
            finally
            {
                isLoadingVehicleExpiringCount = false;
            }
        }
    }
}
