@page "/events/new"
@attribute [Authorize(Roles = "Planificador,Administrador")]
@using System.ComponentModel.DataAnnotations
@using Checkbus.Web.Components.Maps
@using Checkbus.Web.Features.Events.Contracts
@using Checkbus.Web.Features.Events.Services
@using Checkbus.Web.Shared.Models
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Checkbus - Nuevo evento</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    <MudPaper Elevation="2" Class="pa-8">
        <MudText Typo="Typo.h4" Color="Color.Secondary" Class="font-weight-bold mb-2">
            Nuevo evento
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
            Registrá un concierto o partido al que luego se puedan publicar viajes.
        </MudText>

        @if (errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }

        <EditForm Model="model" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />

            <MudTextField T="string"
                           @bind-Value="model.Name"
                           For="@(() => model.Name)"
                           Label="Nombre del evento"
                           Variant="Variant.Outlined"
                           Class="mb-4" />

            <MudSelect T="WebEventType?"
                       @bind-Value="model.Type"
                       For="@(() => model.Type)"
                       Label="Tipo"
                       Placeholder="Elegí un tipo"
                       Variant="Variant.Outlined"
                       Class="mb-4">
                <MudSelectItem T="WebEventType?" Value="WebEventType.Concierto">Concierto</MudSelectItem>
                <MudSelectItem T="WebEventType?" Value="WebEventType.Partido">Partido</MudSelectItem>
            </MudSelect>

            <MudDatePicker Label="Fecha"
                           @bind-Date="model.Date"
                           For="@(() => model.Date)"
                           Class="mb-4" />

            <MudTimePicker Label="Hora"
                           @bind-Time="model.Time"
                           For="@(() => model.Time)"
                           Class="mb-4" />

            <MudText Typo="Typo.subtitle2" Class="mb-2">Ubicación</MudText>
            <LocationPicker Mode="LocationPickerMode.Single" OnLocationPicked="HandleLocationPicked" />

            @if (model.PickedLocation is null)
            {
                <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-2 mb-4">
                    Elegí una ubicación en el mapa o buscala por nombre.
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2 mb-4">
                    Seleccionado: @model.PickedLocation.Nombre (@model.PickedLocation.Direccion)
                </MudText>
            }

            <MudText Typo="Typo.subtitle2" Class="mb-2">Imagen (opcional)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                Spot publicitario o foto de la banda/equipo — se muestra a los pasajeros en la
                página de reserva.
            </MudText>
            <InputFile OnChange="OnImageSelected" accept="image/jpeg,image/png,image/webp" />
            @if (selectedImage is not null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2 mb-4">
                    Seleccionada: @selectedImage.Name
                </MudText>
            }

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       DropShadow="false"
                       FullWidth="true"
                       Disabled="isSubmitting"
                       Class="mt-2">
                @if (isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Registrar evento</span>
                }
            </MudButton>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    [Inject]
    private EventsClient EventsClient { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = default!;

    // Comfortably above Blazor's 500KB default OpenReadStream buffer and matching the backend's
    // 5MB cap, same convention as VehicleDocuments.razor/MyDocuments.razor.
    private const long MaxUploadSizeBytes = 5 * 1024 * 1024;

    private EventFormModel model = new();
    private IBrowserFile? selectedImage;
    private bool isSubmitting;
    private string? errorMessage;

    private void HandleLocationPicked(PickedLocation location)
    {
        model.PickedLocation = location;
    }

    private void OnImageSelected(InputFileChangeEventArgs e)
    {
        selectedImage = e.File;
    }

    private async Task HandleValidSubmit()
    {
        if (model.PickedLocation is null)
        {
            errorMessage = "Elegí una ubicación en el mapa o buscala por nombre.";
            return;
        }

        isSubmitting = true;
        try
        {
            var outcome = await EventsClient.CreateAsync(model.ToRequest());

            switch (outcome)
            {
                case EventActionOutcome.Success success:
                    errorMessage = null;

                    // The image upload is a second, separate request after the Event already
                    // exists (same two-step shape as a Vehicle's documents) — a failure here does
                    // NOT roll back the just-created Event, since there is no transactional link
                    // between the two calls. Surface it clearly instead of silently swallowing it,
                    // so the planificador knows to retry just the image from a future edit screen.
                    if (selectedImage is not null)
                    {
                        await using var stream = selectedImage.OpenReadStream(maxAllowedSize: MaxUploadSizeBytes);
                        var imageOutcome = await EventsClient.UploadImageAsync(
                            success.Event.Id, stream, selectedImage.Name, selectedImage.ContentType);

                        if (imageOutcome is not EventImageUploadOutcome.Success)
                        {
                            Snackbar.Add(
                                "Evento registrado, pero no pudimos subir la imagen. Podés reintentarlo más tarde.",
                                Severity.Warning);
                            NavigationManager.NavigateTo("/events");
                            break;
                        }
                    }

                    Snackbar.Add("Evento registrado.", Severity.Success);
                    NavigationManager.NavigateTo("/events");
                    break;

                case EventActionOutcome.ValidationFailed validationFailed:
                    errorMessage = string.Join(" ", validationFailed.Errors.Values.SelectMany(messages => messages));
                    break;

                case EventActionOutcome.Forbidden:
                    errorMessage = "No tenés permiso para registrar eventos. Iniciá sesión de nuevo con una cuenta de planificador o administrador.";
                    break;

                case EventActionOutcome.TransportError transportError:
                    errorMessage = transportError.Message;
                    break;
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    /// <summary>
    /// Local form-bound model for <see cref="EditForm"/>/<c>DataAnnotationsValidator</c>. Every
    /// field is nullable so a missing selection fails <c>[Required]</c> validation instead of
    /// silently defaulting to the enum's/struct's zero value, same reasoning as
    /// <c>MaintenanceNew.razor</c>'s <c>MaintenanceRecordFormModel</c>. <see cref="PickedLocation"/>
    /// comes from R3's <c>LocationPicker</c> component rather than a data-annotated field, so its
    /// presence is checked explicitly in <c>HandleValidSubmit</c>.
    /// </summary>
    private sealed class EventFormModel
    {
        [Required(ErrorMessage = "Ingresá el nombre del evento.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Seleccioná un tipo de evento.")]
        public WebEventType? Type { get; set; }

        [Required(ErrorMessage = "Ingresá la fecha del evento.")]
        public DateTime? Date { get; set; }

        [Required(ErrorMessage = "Ingresá la hora del evento.")]
        public TimeSpan? Time { get; set; }

        public PickedLocation? PickedLocation { get; set; }

        public CreateEventRequest ToRequest() => new()
        {
            Name = Name,
            Type = Type!.Value,
            Date = Date!.Value.Date + Time!.Value,
            LocationName = PickedLocation!.Nombre,
            Address = PickedLocation!.Direccion,
            PlaceId = PickedLocation!.PlaceId,
            Latitude = PickedLocation!.Latitud,
            Longitude = PickedLocation!.Longitud
        };
    }
}
