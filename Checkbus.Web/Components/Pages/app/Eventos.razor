@page "/eventos"
@attribute [Authorize(Roles = "Planificador,Administrador")]
@using Checkbus.Web.Contracts
@using Checkbus.Web.Services

<PageTitle>Checkbus - Eventos</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
        <MudText Typo="Typo.h4" Color="Color.Secondary" Class="font-weight-bold">
            Eventos
        </MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Event"
                   OnClick="@(() => NavigationManager.NavigateTo("/eventos/new"))">
            Nuevo evento
        </MudButton>
    </MudStack>

    @if (errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
    }

    <MudPaper Elevation="2" Class="pa-6">
        @if (isLoading)
        {
            <MudProgressCircular Indeterminate="true" Class="my-4" />
        }
        else
        {
            <MudDataGrid T="EventoResponse" Items="@eventos">
                <Columns>
                    <PropertyColumn Property="x => x.Nombre" Title="Nombre" />
                    <TemplateColumn Title="Tipo">
                        <CellTemplate>
                            @GetTipoLabel(context.Item.Tipo)
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Fecha">
                        <CellTemplate>
                            @context.Item.Fecha.ToString("dd/MM/yyyy HH:mm")
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Ubicación">
                        <CellTemplate>
                            @($"{context.Item.Ubicacion.Nombre} ({context.Item.Ubicacion.Direccion})")
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        }
    </MudPaper>
</MudContainer>

@code {
    [Inject]
    private EventosClient EventosClient { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private IReadOnlyList<EventoResponse> eventos = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var outcome = await EventosClient.GetListAsync();

            switch (outcome)
            {
                case EventosListOutcome.Success success:
                    eventos = success.Eventos;
                    errorMessage = null;
                    break;

                case EventosListOutcome.Forbidden:
                case EventosListOutcome.TransportError:
                    errorMessage = "No pudimos cargar los eventos.";
                    break;
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    /// Spanish display label for an evento type. A direct <c>ToString()</c> would already match
    /// (both enum member names are Spanish words with no spaces), but this keeps the mapping
    /// explicit and future-proof, same pattern as <c>Maintenance.razor</c>'s type/status labels.
    /// </summary>
    private static string GetTipoLabel(WebEventoTipo tipo) => tipo switch
    {
        WebEventoTipo.Concierto => "Concierto",
        WebEventoTipo.Partido => "Partido",
        _ => tipo.ToString()
    };
}
