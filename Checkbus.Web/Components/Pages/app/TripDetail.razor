@page "/trips/{id:guid}"
@attribute [Authorize(Roles = "Planificador,Administrador")]
@using Checkbus.Web.Features.Trips.Contracts
@using Checkbus.Web.Features.Trips.Services
@using Checkbus.Web.Shared

<PageTitle>Checkbus - Detalle de viaje</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Class="my-4" />
    }
    else if (errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }
    else if (trip is not null)
    {
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.h4" Color="Color.Secondary" Class="font-weight-bold">
                Viaje a @trip.EventName
            </MudText>
            <MudStack Row="true" Spacing="2">
                @if (trip.Status == WebTripStatus.Programado)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@isPublishing"
                               OnClick="HandlePublish">
                        @if (isPublishing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Publicando...</span>
                        }
                        else
                        {
                            <span>Publicar Viaje</span>
                        }
                    </MudButton>
                }
                @if (trip.Status is WebTripStatus.Programado or WebTripStatus.Publicado)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="OpenCancelTripDialog">
                        Cancelar viaje
                    </MudButton>
                }
            </MudStack>
        </MudStack>

        @if (trip.Status == WebTripStatus.Publicado)
        {
            <MudPaper Elevation="0" Class="pa-4 mb-6" Style="background-color: var(--mud-palette-background-grey);">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Link público para compartir</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudTextField T="string" Value="@PublicReservationUrl" ReadOnly="true" Variant="Variant.Outlined" FullWidth="true" />
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Primary" OnClick="CopyPublicUrlToClipboard" />
                </MudStack>
            </MudPaper>
        }

        @if (publishErrorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@publishErrorMessage</MudAlert>
        }

        <MudPaper Elevation="2" Class="pa-6 mb-6">
            <MudText Typo="Typo.h6" Class="mb-4">Datos del viaje</MudText>
            <MudGrid>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Vehículo</MudText>
                    <MudText Typo="Typo.body1">@($"{trip.VehiclePatent} ({trip.VehicleBrand} {trip.VehicleModel})")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Chofer</MudText>
                    <MudText Typo="Typo.body1">@($"{trip.DriverName} {trip.DriverSurname}")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Salida</MudText>
                    <MudText Typo="Typo.body1">@trip.DepartureDate.ToString("dd/MM/yyyy HH:mm")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Llegada</MudText>
                    <MudText Typo="Typo.body1">@trip.ArrivalDate.ToString("dd/MM/yyyy HH:mm")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Estado</MudText>
                    <MudText Typo="Typo.body1">@GetStatusLabel(trip.Status)</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Precio</MudText>
                    <MudText Typo="Typo.body1">@trip.Price.ToString("C")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Capacidad</MudText>
                    <MudText Typo="Typo.body1">@trip.Capacity</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Asientos disponibles</MudText>
                    <MudText Typo="Typo.body1">@trip.AvailableSeats</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="2" Class="pa-6 mb-6">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.h6">Ruta</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="OpenEditStopTimesDialog">
                    Editar horarios
                </MudButton>
            </MudStack>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                @trip.Route.DistanceKm.ToString("0.#") km · @trip.Route.EstimatedDuration.ToString(@"hh\:mm")
            </MudText>

            <MudList T="StopResponse" Dense="true">
                @foreach (var stop in trip.Route.Stops.OrderBy(s => s.Order))
                {
                    <MudListItem T="StopResponse">
                        <MudText Typo="Typo.body1">
                            @(stop.Order + 1). @GetStopTypeLabel(stop.Type) — @stop.Name
                            @if (stop.DepartureTime is { } departureTime)
                            {
                                <span> — @departureTime.ToString("HH:mm")</span>
                            }
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@stop.Address</MudText>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>

        @if (stopTimesErrorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@stopTimesErrorMessage</MudAlert>
        }

        <MudPaper Elevation="2" Class="pa-6">
            <MudText Typo="Typo.h6" Class="mb-2">Mapa de asientos</MudText>

            @if (isLoadingSeatMap)
            {
                <MudProgressCircular Indeterminate="true" Class="my-4" />
            }
            else if (seatMapErrorMessage is not null)
            {
                <MudAlert Severity="Severity.Error">@seatMapErrorMessage</MudAlert>
            }
            else if (seatMap is not null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    @seatMap.OccupiedSeatNumbers.Count / @seatMap.Capacity asientos ocupados — vista de solo lectura, sin datos de pasajeros.
                </MudText>

                @foreach (var row in seatRows)
                {
                    <MudStack Row="true" Justify="Justify.Center" Spacing="2" Class="mb-2">
                        @foreach (var slot in row)
                        {
                            @if (slot is null)
                            {
                                <div style="width: 48px;"></div>
                            }
                            else
                            {
                                var seatNumber = slot.Value;
                                var occupied = seatMap.OccupiedSeatNumbers.Contains(seatNumber);

                                <MudButton Variant="Variant.Outlined"
                                           Color="@(occupied ? Color.Default : Color.Secondary)"
                                           Disabled="true"
                                           Style="min-width: 48px;">
                                    @seatNumber
                                </MudButton>
                            }
                        }
                    </MudStack>
                }
            }
        </MudPaper>
    }
</MudContainer>

@if (isEditStopTimesDialogOpen && trip is not null)
{
    <MudDialog Visible="true" Options="@(new DialogOptions { CloseOnEscapeKey = true })">
        <TitleContent>
            <MudText Typo="Typo.h6">Editar horarios de paradas</MudText>
        </TitleContent>
        <DialogContent>
            @if (stopTimesSubmitErrorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@stopTimesSubmitErrorMessage</MudAlert>
            }
            @foreach (var stopEdit in stopTimeEdits)
            {
                <MudStack Row="true" Spacing="2" Class="mb-3" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body1" Style="min-width: 220px;">
                        @(stopEdit.Order + 1). @stopEdit.Name
                    </MudText>
                    <MudDatePicker Label="Fecha" @bind-Date="stopEdit.Date" />
                    <MudTimePicker Label="Hora" @bind-Time="stopEdit.Time" />
                </MudStack>
            }
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="CloseEditStopTimesDialog">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@isSavingStopTimes" OnClick="SaveStopTimesAsync">
                @if (isSavingStopTimes)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Guardar</span>
                }
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@if (trip is not null)
{
    <MudDialog Visible="@isCancelTripDialogOpen" Options="@(new DialogOptions { CloseOnEscapeKey = true })">
        <TitleContent>
            <MudText Typo="Typo.h6">Cancelar viaje</MudText>
        </TitleContent>
        <DialogContent>
            @if (cancelTripErrorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@cancelTripErrorMessage</MudAlert>
            }
            @if (!isCancelTripConfirmationStep)
            {
                <MudSelect T="WebTripCancellationReason"
                           @bind-Value="cancelReason"
                           Label="Motivo"
                           Variant="Variant.Outlined"
                           Class="mb-4">
                    @foreach (var reason in CancellationReasons)
                    {
                        <MudSelectItem T="WebTripCancellationReason" Value="@reason">@GetCancellationReasonLabel(reason)</MudSelectItem>
                    }
                </MudSelect>

                <MudTextField T="string"
                               @bind-Value="cancelDescription"
                               Label="Descripción"
                               HelperText="@(cancelReason == WebTripCancellationReason.Otro ? "Obligatoria para el motivo \"Otro\"." : "Opcional")"
                               Variant="Variant.Outlined"
                               Lines="3" />
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Class="mb-2">
                    Esto va a cancelar el viaje a <strong>@trip.EventName</strong> del
                    <strong>@trip.DepartureDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>,
                    notificar a todos los pasajeros con reserva y procesar sus reembolsos
                    correspondientes. Esta acción no se puede deshacer.
                </MudAlert>
                <MudText Typo="Typo.body2"><strong>Motivo:</strong> @GetCancellationReasonLabel(cancelReason)</MudText>
                @if (!string.IsNullOrWhiteSpace(cancelDescription))
                {
                    <MudText Typo="Typo.body2"><strong>Descripción:</strong> @cancelDescription</MudText>
                }
            }
        </DialogContent>
        <DialogActions>
            @if (!isCancelTripConfirmationStep)
            {
                <MudButton OnClick="CloseCancelTripDialog">Cerrar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ContinueToCancelConfirmation">
                    Continuar
                </MudButton>
            }
            else
            {
                <MudButton Disabled="@isCancellingTrip" OnClick="@(() => isCancelTripConfirmationStep = false)">
                    Volver
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@isCancellingTrip" OnClick="ConfirmCancelTripAsync">
                    @if (isCancellingTrip)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Cancelando...</span>
                    }
                    else
                    {
                        <span>Confirmar cancelación</span>
                    }
                </MudButton>
            }
        </DialogActions>
    </MudDialog>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [Inject]
    private TripsClient TripsClient { get; set; } = default!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    [Inject]
    private IJSRuntime JsRuntime { get; set; } = default!;

    private TripDetailResponse? trip;
    private string PublicReservationUrl => NavigationManager.ToAbsoluteUri($"/reservar/{Id}").ToString();
    private bool isLoading = true;
    private string? errorMessage;
    private bool isPublishing;
    private string? publishErrorMessage;

    // Fase E — seat-map panel (odd/tasks/mejoras-detalle-viaje.md).
    private bool isLoadingSeatMap;
    private string? seatMapErrorMessage;
    private TripSeatMapResponse? seatMap;
    private List<int?[]> seatRows = [];

    // CU-05 — cancel trip dialog.
    private static readonly WebTripCancellationReason[] CancellationReasons = Enum.GetValues<WebTripCancellationReason>();
    private bool isCancelTripDialogOpen;
    private bool isCancelTripConfirmationStep;
    private bool isCancellingTrip;
    private string? cancelTripErrorMessage;
    private WebTripCancellationReason cancelReason = WebTripCancellationReason.ProblemaChofer;
    private string? cancelDescription;

    // Fase D — stop times edit dialog (odd/tasks/mejoras-detalle-viaje.md).
    private bool isEditStopTimesDialogOpen;
    private bool isSavingStopTimes;
    private string? stopTimesErrorMessage;
    private string? stopTimesSubmitErrorMessage;
    private List<StopTimeEditModel> stopTimeEdits = [];

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var outcome = await TripsClient.GetByIdAsync(Id);

            switch (outcome)
            {
                case TripOutcome.Success success:
                    trip = success.Trip;
                    errorMessage = null;
                    break;

                case TripOutcome.NotFound:
                    errorMessage = "No encontramos ese viaje.";
                    break;

                case TripOutcome.Forbidden:
                case TripOutcome.TransportError:
                    errorMessage = "No pudimos cargar el viaje.";
                    break;
            }
        }
        finally
        {
            isLoading = false;
        }

        if (trip is not null)
        {
            await LoadSeatMapAsync();
        }
    }

    private async Task LoadSeatMapAsync()
    {
        isLoadingSeatMap = true;
        try
        {
            var outcome = await TripsClient.GetSeatMapAsync(Id);

            switch (outcome)
            {
                case TripSeatMapOutcome.Success success:
                    seatMap = success.SeatMap;
                    seatMapErrorMessage = null;
                    seatRows = SeatGridLayout.BuildSeatRows(success.SeatMap.Capacity);
                    break;

                case TripSeatMapOutcome.NotFound:
                    seatMapErrorMessage = "No encontramos ese viaje.";
                    break;

                case TripSeatMapOutcome.Forbidden:
                    seatMapErrorMessage = "No tenés permiso para ver el mapa de asientos de este viaje.";
                    break;

                case TripSeatMapOutcome.TransportError transportError:
                    seatMapErrorMessage = transportError.Message;
                    break;
            }
        }
        finally
        {
            isLoadingSeatMap = false;
        }
    }

    private void OpenEditStopTimesDialog()
    {
        if (trip is null)
        {
            return;
        }

        stopTimesSubmitErrorMessage = null;
        stopTimeEdits = trip.Route.Stops
            .OrderBy(s => s.Order)
            .Select(s => new StopTimeEditModel
            {
                StopId = s.Id,
                Order = s.Order,
                Name = s.Name,
                Date = s.DepartureTime?.Date,
                Time = s.DepartureTime?.TimeOfDay
            })
            .ToList();

        isEditStopTimesDialogOpen = true;
    }

    private void CloseEditStopTimesDialog()
    {
        isEditStopTimesDialogOpen = false;
    }

    private async Task SaveStopTimesAsync()
    {
        stopTimesSubmitErrorMessage = null;

        if (stopTimeEdits.Any(s => s.Date is null || s.Time is null))
        {
            stopTimesSubmitErrorMessage = "Completá la fecha y la hora de cada parada.";
            return;
        }

        isSavingStopTimes = true;
        try
        {
            var request = new UpdateStopTimesRequest
            {
                Stops = stopTimeEdits
                    .Select(s => new StopDepartureTimeRequest
                    {
                        StopId = s.StopId,
                        DepartureTime = s.Date!.Value.Date + s.Time!.Value
                    })
                    .ToList()
            };

            var outcome = await TripsClient.UpdateStopTimesAsync(Id, request);

            switch (outcome)
            {
                case TripStopTimesUpdateOutcome.Success:
                    isEditStopTimesDialogOpen = false;
                    stopTimesErrorMessage = null;
                    Snackbar.Add("Horarios actualizados correctamente.", Severity.Success);
                    // Re-fetch so the Paradas list reflects the saved values.
                    var refreshed = await TripsClient.GetByIdAsync(Id);
                    if (refreshed is TripOutcome.Success refreshedSuccess)
                    {
                        trip = refreshedSuccess.Trip;
                    }
                    break;

                case TripStopTimesUpdateOutcome.ValidationFailed validationFailed:
                    stopTimesSubmitErrorMessage = string.Join(" ", validationFailed.Errors.Values.SelectMany(messages => messages));
                    break;

                case TripStopTimesUpdateOutcome.NotFound:
                    stopTimesSubmitErrorMessage = "No encontramos ese viaje o alguna de sus paradas.";
                    break;

                case TripStopTimesUpdateOutcome.Forbidden:
                    stopTimesSubmitErrorMessage = "No tenés permiso para editar los horarios de este viaje.";
                    break;

                case TripStopTimesUpdateOutcome.TransportError transportError:
                    stopTimesSubmitErrorMessage = transportError.Message;
                    break;
            }
        }
        finally
        {
            isSavingStopTimes = false;
        }
    }

    private sealed class StopTimeEditModel
    {
        public Guid StopId { get; set; }
        public int Order { get; set; }
        public required string Name { get; set; }
        public DateTime? Date { get; set; }
        public TimeSpan? Time { get; set; }
    }

    private async Task CopyPublicUrlToClipboard()
    {
        // navigator.clipboard is a built-in browser API — invoked directly via IJSRuntime
        // rather than adding a new .js interop module for a single one-line call.
        await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", PublicReservationUrl);
        Snackbar.Add("Link copiado.", Severity.Success);
    }

    private async Task HandlePublish()
    {
        publishErrorMessage = null;
        isPublishing = true;
        try
        {
            var outcome = await TripsClient.PublishAsync(Id);

            switch (outcome)
            {
                case TripPublishOutcome.Success:
                    // Flip locally rather than re-fetching — the only field this action changes
                    // is Status, and we already have the rest of the detail loaded.
                    trip = trip! with { Status = WebTripStatus.Publicado };
                    Snackbar.Add("Viaje publicado correctamente.", Severity.Success);
                    break;

                case TripPublishOutcome.ValidationFailed validationFailed:
                    publishErrorMessage = string.Join(" ", validationFailed.Errors.Values.SelectMany(messages => messages));
                    break;

                case TripPublishOutcome.NotFound:
                    publishErrorMessage = "No encontramos ese viaje.";
                    break;

                case TripPublishOutcome.Forbidden:
                    publishErrorMessage = "No tenés permiso para publicar este viaje.";
                    break;

                case TripPublishOutcome.TransportError transportError:
                    publishErrorMessage = transportError.Message;
                    break;
            }
        }
        finally
        {
            isPublishing = false;
        }
    }

    private void OpenCancelTripDialog()
    {
        isCancelTripDialogOpen = true;
        isCancelTripConfirmationStep = false;
        cancelTripErrorMessage = null;
        cancelReason = WebTripCancellationReason.ProblemaChofer;
        cancelDescription = null;
    }

    private void CloseCancelTripDialog()
    {
        isCancelTripDialogOpen = false;
    }

    private void ContinueToCancelConfirmation()
    {
        if (cancelReason == WebTripCancellationReason.Otro && string.IsNullOrWhiteSpace(cancelDescription))
        {
            cancelTripErrorMessage = "Ingresá una descripción para el motivo \"Otro\".";
            return;
        }

        cancelTripErrorMessage = null;
        isCancelTripConfirmationStep = true;
    }

    private async Task ConfirmCancelTripAsync()
    {
        cancelTripErrorMessage = null;
        isCancellingTrip = true;
        try
        {
            var outcome = await TripsClient.CancelAsync(
                Id, new CancelTripRequest { Reason = cancelReason, Description = cancelDescription });

            switch (outcome)
            {
                case TripCancelOutcome.Success:
                    trip = trip! with { Status = WebTripStatus.Cancelado };
                    isCancelTripDialogOpen = false;
                    Snackbar.Add("Viaje cancelado correctamente.", Severity.Success);
                    break;

                case TripCancelOutcome.ValidationFailed validationFailed:
                    cancelTripErrorMessage = string.Join(" ", validationFailed.Errors.Values.SelectMany(messages => messages));
                    break;

                case TripCancelOutcome.NotFound:
                    cancelTripErrorMessage = "No encontramos ese viaje.";
                    break;

                case TripCancelOutcome.Forbidden:
                    cancelTripErrorMessage = "No tenés permiso para cancelar este viaje.";
                    break;

                case TripCancelOutcome.TransportError transportError:
                    cancelTripErrorMessage = transportError.Message;
                    break;
            }
        }
        finally
        {
            isCancellingTrip = false;
        }
    }

    private static string GetCancellationReasonLabel(WebTripCancellationReason reason) => reason switch
    {
        WebTripCancellationReason.ProblemaChofer => "Problema con el chofer",
        WebTripCancellationReason.DesperfectoVehiculo => "Desperfecto del vehículo",
        WebTripCancellationReason.DemandaInsuficiente => "Demanda insuficiente",
        WebTripCancellationReason.CondicionesClimaticas => "Condiciones climáticas",
        WebTripCancellationReason.DocumentacionVencida => "Documentación vencida",
        WebTripCancellationReason.CausaOperativa => "Causa operativa",
        WebTripCancellationReason.Otro => "Otro",
        _ => reason.ToString()
    };

    private static string GetStatusLabel(WebTripStatus status) => status switch
    {
        WebTripStatus.Programado => "Programado",
        WebTripStatus.EnProceso => "En proceso",
        WebTripStatus.Completado => "Completado",
        WebTripStatus.Cancelado => "Cancelado",
        WebTripStatus.Publicado => "Publicado",
        _ => status.ToString()
    };

    private static string GetStopTypeLabel(WebStopType type) => type switch
    {
        WebStopType.Origen => "Origen",
        WebStopType.Intermedia => "Parada",
        WebStopType.Destino => "Destino",
        _ => type.ToString()
    };
}
