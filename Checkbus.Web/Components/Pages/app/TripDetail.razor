@page "/trips/{id:guid}"
@attribute [Authorize(Roles = "Planificador,Administrador")]
@using Checkbus.Web.Features.Trips.Contracts
@using Checkbus.Web.Features.Trips.Services

<PageTitle>Checkbus - Detalle de viaje</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Class="my-4" />
    }
    else if (errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }
    else if (trip is not null)
    {
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.h4" Color="Color.Secondary" Class="font-weight-bold">
                Viaje a @trip.EventName
            </MudText>
            @if (trip.Status == WebTripStatus.Programado)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@isPublishing"
                           OnClick="HandlePublish">
                    @if (isPublishing)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Publicando...</span>
                    }
                    else
                    {
                        <span>Publicar Viaje</span>
                    }
                </MudButton>
            }
        </MudStack>

        @if (trip.Status == WebTripStatus.Publicado)
        {
            <MudPaper Elevation="0" Class="pa-4 mb-6" Style="background-color: var(--mud-palette-background-grey);">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Link público para compartir</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudTextField T="string" Value="@PublicReservationUrl" ReadOnly="true" Variant="Variant.Outlined" FullWidth="true" />
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Primary" OnClick="CopyPublicUrlToClipboard" />
                </MudStack>
            </MudPaper>
        }

        @if (publishErrorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@publishErrorMessage</MudAlert>
        }

        <MudPaper Elevation="2" Class="pa-6 mb-6">
            <MudText Typo="Typo.h6" Class="mb-4">Datos del viaje</MudText>
            <MudGrid>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Vehículo</MudText>
                    <MudText Typo="Typo.body1">@($"{trip.VehiclePatent} ({trip.VehicleBrand} {trip.VehicleModel})")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Chofer</MudText>
                    <MudText Typo="Typo.body1">@($"{trip.DriverName} {trip.DriverSurname}")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Salida</MudText>
                    <MudText Typo="Typo.body1">@trip.DepartureDate.ToString("dd/MM/yyyy HH:mm")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Llegada</MudText>
                    <MudText Typo="Typo.body1">@trip.ArrivalDate.ToString("dd/MM/yyyy HH:mm")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Estado</MudText>
                    <MudText Typo="Typo.body1">@GetStatusLabel(trip.Status)</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Precio</MudText>
                    <MudText Typo="Typo.body1">@trip.Price.ToString("C")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Capacidad</MudText>
                    <MudText Typo="Typo.body1">@trip.Capacity</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Asientos disponibles</MudText>
                    <MudText Typo="Typo.body1">@trip.AvailableSeats</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="2" Class="pa-6">
            <MudText Typo="Typo.h6" Class="mb-2">Ruta</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                @trip.Route.DistanceKm.ToString("0.#") km · @trip.Route.EstimatedDuration.ToString(@"hh\:mm")
            </MudText>

            <MudList T="StopResponse" Dense="true">
                @foreach (var stop in trip.Route.Stops.OrderBy(s => s.Order))
                {
                    <MudListItem T="StopResponse">
                        <MudText Typo="Typo.body1">@(stop.Order + 1). @GetStopTypeLabel(stop.Type) — @stop.Name</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@stop.Address</MudText>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter]
    public Guid Id { get; set; }

    [Inject]
    private TripsClient TripsClient { get; set; } = default!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    [Inject]
    private IJSRuntime JsRuntime { get; set; } = default!;

    private TripDetailResponse? trip;
    private string PublicReservationUrl => NavigationManager.ToAbsoluteUri($"/reservar/{Id}").ToString();
    private bool isLoading = true;
    private string? errorMessage;
    private bool isPublishing;
    private string? publishErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var outcome = await TripsClient.GetByIdAsync(Id);

            switch (outcome)
            {
                case TripOutcome.Success success:
                    trip = success.Trip;
                    errorMessage = null;
                    break;

                case TripOutcome.NotFound:
                    errorMessage = "No encontramos ese viaje.";
                    break;

                case TripOutcome.Forbidden:
                case TripOutcome.TransportError:
                    errorMessage = "No pudimos cargar el viaje.";
                    break;
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CopyPublicUrlToClipboard()
    {
        // navigator.clipboard is a built-in browser API — invoked directly via IJSRuntime
        // rather than adding a new .js interop module for a single one-line call.
        await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", PublicReservationUrl);
        Snackbar.Add("Link copiado.", Severity.Success);
    }

    private async Task HandlePublish()
    {
        publishErrorMessage = null;
        isPublishing = true;
        try
        {
            var outcome = await TripsClient.PublishAsync(Id);

            switch (outcome)
            {
                case TripPublishOutcome.Success:
                    // Flip locally rather than re-fetching — the only field this action changes
                    // is Status, and we already have the rest of the detail loaded.
                    trip = trip! with { Status = WebTripStatus.Publicado };
                    Snackbar.Add("Viaje publicado correctamente.", Severity.Success);
                    break;

                case TripPublishOutcome.ValidationFailed validationFailed:
                    publishErrorMessage = string.Join(" ", validationFailed.Errors.Values.SelectMany(messages => messages));
                    break;

                case TripPublishOutcome.NotFound:
                    publishErrorMessage = "No encontramos ese viaje.";
                    break;

                case TripPublishOutcome.Forbidden:
                    publishErrorMessage = "No tenés permiso para publicar este viaje.";
                    break;

                case TripPublishOutcome.TransportError transportError:
                    publishErrorMessage = transportError.Message;
                    break;
            }
        }
        finally
        {
            isPublishing = false;
        }
    }

    private static string GetStatusLabel(WebTripStatus status) => status switch
    {
        WebTripStatus.Programado => "Programado",
        WebTripStatus.EnProceso => "En proceso",
        WebTripStatus.Completado => "Completado",
        WebTripStatus.Cancelado => "Cancelado",
        WebTripStatus.Publicado => "Publicado",
        _ => status.ToString()
    };

    private static string GetStopTypeLabel(WebStopType type) => type switch
    {
        WebStopType.Origen => "Origen",
        WebStopType.Intermedia => "Parada",
        WebStopType.Destino => "Destino",
        _ => type.ToString()
    };
}
