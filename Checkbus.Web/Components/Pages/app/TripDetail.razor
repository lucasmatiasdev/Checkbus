@page "/trips/{id:guid}"
@attribute [Authorize(Roles = "Planificador,Administrador")]
@using Checkbus.Web.Features.Trips.Contracts
@using Checkbus.Web.Features.Trips.Services
@using Checkbus.Web.Features.Notifications.Contracts
@using Checkbus.Web.Features.Notifications.Services
@using Checkbus.Web.Shared
@implements IDisposable

<PageTitle>Checkbus - Detalle de viaje</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Class="my-4" />
    }
    else if (errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }
    else if (trip is not null)
    {
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.h4" Color="Color.Secondary" Class="font-weight-bold">
                Viaje a @trip.EventName
            </MudText>
            <MudStack Row="true" Spacing="2">
                @if (trip.Status == WebTripStatus.Programado)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@isPublishing"
                               OnClick="HandlePublish">
                        @if (isPublishing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Publicando...</span>
                        }
                        else
                        {
                            <span>Publicar Viaje</span>
                        }
                    </MudButton>
                }
                @if (trip.Status == WebTripStatus.Publicado)
                {
                    <MudTooltip Text="@(CanStartTrip ? null : "Se habilita 30 minutos antes de la salida programada.")">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(isStarting || !CanStartTrip)"
                                   OnClick="HandleStart">
                            @if (isStarting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>Iniciando...</span>
                            }
                            else
                            {
                                <span>Iniciar viaje</span>
                            }
                        </MudButton>
                    </MudTooltip>
                }
                @if (trip.Status == WebTripStatus.EnProceso)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenFinishTripDialog">
                        Finalizar viaje
                    </MudButton>
                }
                @if (trip.Status is WebTripStatus.Programado or WebTripStatus.Publicado)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="OpenCancelTripDialog">
                        Cancelar viaje
                    </MudButton>
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="OpenSendNotificationDialog">
                    Enviar notificación
                </MudButton>
            </MudStack>
        </MudStack>

        @if (trip.Status == WebTripStatus.Publicado)
        {
            <MudPaper Elevation="0" Class="pa-4 mb-6" Style="background-color: var(--mud-palette-background-grey);">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Link público para compartir</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudTextField T="string" Value="@PublicReservationUrl" ReadOnly="true" Variant="Variant.Outlined" FullWidth="true" />
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Primary" OnClick="CopyPublicUrlToClipboard" />
                </MudStack>
            </MudPaper>
        }

        @if (publishErrorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@publishErrorMessage</MudAlert>
        }

        @if (startErrorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@startErrorMessage</MudAlert>
        }

        <MudPaper Elevation="2" Class="pa-6 mb-6">
            <MudText Typo="Typo.h6" Class="mb-4">Datos del viaje</MudText>
            <MudGrid>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Vehículo</MudText>
                    <MudText Typo="Typo.body1">@($"{trip.VehiclePatent} ({trip.VehicleBrand} {trip.VehicleModel})")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Chofer</MudText>
                    <MudText Typo="Typo.body1">@($"{trip.DriverName} {trip.DriverSurname}")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Salida</MudText>
                    <MudText Typo="Typo.body1">@trip.DepartureDate.ToString("dd/MM/yyyy HH:mm")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Llegada</MudText>
                    <MudText Typo="Typo.body1">@trip.ArrivalDate.ToString("dd/MM/yyyy HH:mm")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Estado</MudText>
                    <MudText Typo="Typo.body1">@GetStatusLabel(trip.Status)</MudText>
                </MudItem>
                @if (trip.ActualArrivalDate is not null)
                {
                    <MudItem xs="6">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Llegada real</MudText>
                        <MudText Typo="Typo.body1">@trip.ActualArrivalDate.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudText>
                    </MudItem>
                }
                @if (!string.IsNullOrWhiteSpace(trip.Observations))
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Observaciones</MudText>
                        <MudText Typo="Typo.body1">@trip.Observations</MudText>
                    </MudItem>
                }
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Precio</MudText>
                    <MudText Typo="Typo.body1">@trip.Price.ToString("C")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Capacidad</MudText>
                    <MudText Typo="Typo.body1">@trip.Capacity</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Asientos disponibles</MudText>
                    <MudText Typo="Typo.body1">@trip.AvailableSeats</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (trip.Status == WebTripStatus.Cancelado && pendingRefunds.Count > 0)
        {
            <MudPaper Elevation="2" Class="pa-6 mb-6">
                <MudText Typo="Typo.h6" Class="mb-2">Reembolsos pendientes</MudText>
                <MudAlert Severity="Severity.Warning" Class="mb-4">
                    Estos pagos no se pudieron reembolsar automáticamente. Revisalos manualmente
                    en Mercado Pago.
                </MudAlert>
                <MudList T="PendingRefundResponse">
                    @foreach (var refund in pendingRefunds)
                    {
                        <MudListItem T="PendingRefundResponse">
                            <MudText Typo="Typo.body1">
                                @refund.Amount.ToString("C") — Orden: @(refund.ExternalOrderId ?? "N/A")
                                (@refund.ReservationIds.Count asiento(s))
                            </MudText>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        }

        <MudPaper Elevation="2" Class="pa-6 mb-6">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.h6">Ruta</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="OpenEditStopTimesDialog">
                    Editar horarios
                </MudButton>
            </MudStack>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                @trip.Route.DistanceKm.ToString("0.#") km · @trip.Route.EstimatedDuration.ToString(@"hh\:mm")
            </MudText>

            <MudList T="StopResponse" Dense="true">
                @foreach (var stop in trip.Route.Stops.OrderBy(s => s.Order))
                {
                    <MudListItem T="StopResponse">
                        <MudText Typo="Typo.body1">
                            @(stop.Order + 1). @GetStopTypeLabel(stop.Type) — @stop.Name
                            @if (stop.DepartureTime is { } departureTime)
                            {
                                <span> — @departureTime.ToString("HH:mm")</span>
                            }
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@stop.Address</MudText>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>

        @if (stopTimesErrorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@stopTimesErrorMessage</MudAlert>
        }

        <MudPaper Elevation="2" Class="pa-6">
            <MudText Typo="Typo.h6" Class="mb-2">Mapa de asientos</MudText>

            @if (isLoadingSeatMap)
            {
                <MudProgressCircular Indeterminate="true" Class="my-4" />
            }
            else if (seatMapErrorMessage is not null)
            {
                <MudAlert Severity="Severity.Error">@seatMapErrorMessage</MudAlert>
            }
            else if (seatMap is not null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    @seatMap.OccupiedSeatNumbers.Count / @seatMap.Capacity asientos ocupados — vista de solo lectura, sin datos de pasajeros.
                </MudText>

                @foreach (var row in seatRows)
                {
                    <MudStack Row="true" Justify="Justify.Center" Spacing="2" Class="mb-2">
                        @foreach (var slot in row)
                        {
                            @if (slot is null)
                            {
                                <div style="width: 48px;"></div>
                            }
                            else
                            {
                                var seatNumber = slot.Value;
                                var occupied = seatMap.OccupiedSeatNumbers.Contains(seatNumber);

                                <MudButton Variant="Variant.Outlined"
                                           Color="@(occupied ? Color.Default : Color.Secondary)"
                                           Disabled="true"
                                           Style="min-width: 48px;">
                                    @seatNumber
                                </MudButton>
                            }
                        }
                    </MudStack>
                }
            }
        </MudPaper>

        <MudPaper Elevation="2" Class="pa-6 mt-6">
            <MudText Typo="Typo.h6" Class="mb-4">Historial de notificaciones</MudText>

            @if (isLoadingNotificationHistory)
            {
                <MudProgressCircular Indeterminate="true" Class="my-4" />
            }
            else if (notificationHistory.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Todavía no se envió ninguna notificación para este viaje.</MudText>
            }
            else
            {
                <MudList T="NotificationResponse" Dense="true">
                    @foreach (var notification in notificationHistory.OrderByDescending(n => n.CreatedAt))
                    {
                        <MudListItem T="NotificationResponse">
                            <MudText Typo="Typo.body1">
                                <strong>@GetNotificationReasonLabel(notification.Reason)</strong>
                                — @notification.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                @if (!string.IsNullOrWhiteSpace(notification.CreatedByName))
                                {
                                    <span> — @notification.CreatedByName</span>
                                }
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@notification.Message</MudText>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudPaper>
    }
</MudContainer>

@if (isEditStopTimesDialogOpen && trip is not null)
{
    <MudDialog Visible="true" Options="@(new DialogOptions { CloseOnEscapeKey = true })">
        <TitleContent>
            <MudText Typo="Typo.h6">Editar horarios de paradas</MudText>
        </TitleContent>
        <DialogContent>
            @if (stopTimesSubmitErrorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@stopTimesSubmitErrorMessage</MudAlert>
            }
            @foreach (var stopEdit in stopTimeEdits)
            {
                <MudStack Row="true" Spacing="2" Class="mb-3" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body1" Style="min-width: 220px;">
                        @(stopEdit.Order + 1). @stopEdit.Name
                    </MudText>
                    <MudDatePicker Label="Fecha" @bind-Date="stopEdit.Date" />
                    <MudTimePicker Label="Hora" @bind-Time="stopEdit.Time" />
                </MudStack>
            }
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="CloseEditStopTimesDialog">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@isSavingStopTimes" OnClick="SaveStopTimesAsync">
                @if (isSavingStopTimes)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Guardar</span>
                }
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@if (trip is not null)
{
    <MudDialog Visible="@isCancelTripDialogOpen" Options="@(new DialogOptions { CloseOnEscapeKey = true })">
        <TitleContent>
            <MudText Typo="Typo.h6">Cancelar viaje</MudText>
        </TitleContent>
        <DialogContent>
            @if (cancelTripErrorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@cancelTripErrorMessage</MudAlert>
            }
            @if (!isCancelTripConfirmationStep)
            {
                <MudSelect T="WebTripCancellationReason"
                           @bind-Value="cancelReason"
                           Label="Motivo"
                           Variant="Variant.Outlined"
                           Class="mb-4">
                    @foreach (var reason in CancellationReasons)
                    {
                        <MudSelectItem T="WebTripCancellationReason" Value="@reason">@GetCancellationReasonLabel(reason)</MudSelectItem>
                    }
                </MudSelect>

                <MudTextField T="string"
                               @bind-Value="cancelDescription"
                               Label="Descripción"
                               HelperText="@(cancelReason == WebTripCancellationReason.Otro ? "Obligatoria para el motivo \"Otro\"." : "Opcional")"
                               Variant="Variant.Outlined"
                               Lines="3" />
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Class="mb-2">
                    Esto va a cancelar el viaje a <strong>@trip.EventName</strong> del
                    <strong>@trip.DepartureDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>,
                    notificar a todos los pasajeros con reserva y procesar sus reembolsos
                    correspondientes. Esta acción no se puede deshacer.
                </MudAlert>
                <MudText Typo="Typo.body2"><strong>Motivo:</strong> @GetCancellationReasonLabel(cancelReason)</MudText>
                @if (!string.IsNullOrWhiteSpace(cancelDescription))
                {
                    <MudText Typo="Typo.body2"><strong>Descripción:</strong> @cancelDescription</MudText>
                }
            }
        </DialogContent>
        <DialogActions>
            @if (!isCancelTripConfirmationStep)
            {
                <MudButton OnClick="CloseCancelTripDialog">Cerrar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ContinueToCancelConfirmation">
                    Continuar
                </MudButton>
            }
            else
            {
                <MudButton Disabled="@isCancellingTrip" OnClick="@(() => isCancelTripConfirmationStep = false)">
                    Volver
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@isCancellingTrip" OnClick="ConfirmCancelTripAsync">
                    @if (isCancellingTrip)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Cancelando...</span>
                    }
                    else
                    {
                        <span>Confirmar cancelación</span>
                    }
                </MudButton>
            }
        </DialogActions>
    </MudDialog>

    <MudDialog Visible="@isFinishTripDialogOpen" Options="@(new DialogOptions { CloseOnEscapeKey = true })">
        <TitleContent>
            <MudText Typo="Typo.h6">Finalizar viaje</MudText>
        </TitleContent>
        <DialogContent>
            @if (finishTripErrorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@finishTripErrorMessage</MudAlert>
            }
            <MudStack Row="true" Spacing="2" Class="mb-4">
                <MudDatePicker Label="Fecha de llegada" @bind-Date="finishArrivalDate" />
                <MudTimePicker Label="Hora de llegada" @bind-Time="finishArrivalTime" />
            </MudStack>
            <MudTextField T="string"
                           @bind-Value="finishObservations"
                           Label="Observaciones"
                           HelperText="Opcional"
                           Variant="Variant.Outlined"
                           Lines="3" />
        </DialogContent>
        <DialogActions>
            <MudButton Disabled="@isFinishingTrip" OnClick="CloseFinishTripDialog">Cerrar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@isFinishingTrip" OnClick="ConfirmFinishTripAsync">
                @if (isFinishingTrip)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Finalizando...</span>
                }
                else
                {
                    <span>Finalizar viaje</span>
                }
            </MudButton>
        </DialogActions>
    </MudDialog>

    <MudDialog Visible="@isSendNotificationDialogOpen" Options="@(new DialogOptions { CloseOnEscapeKey = true })">
        <TitleContent>
            <MudText Typo="Typo.h6">Enviar notificación</MudText>
        </TitleContent>
        <DialogContent>
            @if (sendNotificationErrorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@sendNotificationErrorMessage</MudAlert>
            }

            <MudSelect T="WebNotificationReason"
                       @bind-Value="notificationReason"
                       Label="Motivo"
                       Variant="Variant.Outlined"
                       Class="mb-4">
                @foreach (var reason in NotificationReasons)
                {
                    <MudSelectItem T="WebNotificationReason" Value="@reason">@GetNotificationReasonLabel(reason)</MudSelectItem>
                }
            </MudSelect>

            <MudTextField T="string"
                           @bind-Value="notificationMessage"
                           Label="Mensaje"
                           HelperText="Obligatorio"
                           Variant="Variant.Outlined"
                           Lines="3"
                           Class="mb-4" />

            <MudCheckBox T="bool" @bind-Value="notifyWholeEvent" Label="Aplicar a todo el evento" />
        </DialogContent>
        <DialogActions>
            <MudButton Disabled="@isSendingNotification" OnClick="CloseSendNotificationDialog">Cerrar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@isSendingNotification" OnClick="ConfirmSendNotificationAsync">
                @if (isSendingNotification)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Enviando...</span>
                }
                else
                {
                    <span>Enviar</span>
                }
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [Inject]
    private TripsClient TripsClient { get; set; } = default!;

    [Inject]
    private NotificationsClient NotificationsClient { get; set; } = default!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    [Inject]
    private IJSRuntime JsRuntime { get; set; } = default!;

    private TripDetailResponse? trip;
    private string PublicReservationUrl => NavigationManager.ToAbsoluteUri($"/reservar/{trip?.Slug}").ToString();
    private bool isLoading = true;
    private string? errorMessage;
    private bool isPublishing;
    private string? publishErrorMessage;

    // CU-08 — start trip. The ±30-minute window must stay in sync with
    // StartTripCommandHandler.StartWindow; a timer re-checks it periodically so the button
    // enables itself once the window opens, without requiring a page refresh.
    private static readonly TimeSpan StartWindow = TimeSpan.FromMinutes(30);
    private bool isStarting;
    private string? startErrorMessage;
    private System.Threading.Timer? startWindowTimer;
    private bool CanStartTrip =>
        trip is not null
        && DateTime.UtcNow >= trip.DepartureDate - StartWindow
        && DateTime.UtcNow <= trip.DepartureDate + StartWindow;

    // CU-08 — finish trip.
    private bool isFinishTripDialogOpen;
    private bool isFinishingTrip;
    private string? finishTripErrorMessage;
    private DateTime? finishArrivalDate;
    private TimeSpan? finishArrivalTime;
    private string? finishObservations;

    // Fase E — seat-map panel (odd/tasks/mejoras-detalle-viaje.md).
    private bool isLoadingSeatMap;
    private string? seatMapErrorMessage;
    private TripSeatMapResponse? seatMap;
    private List<int?[]> seatRows = [];

    // CU-05 — cancel trip dialog.
    private static readonly WebTripCancellationReason[] CancellationReasons = Enum.GetValues<WebTripCancellationReason>();
    private bool isCancelTripDialogOpen;
    private bool isCancelTripConfirmationStep;
    private bool isCancellingTrip;
    private string? cancelTripErrorMessage;
    private WebTripCancellationReason cancelReason = WebTripCancellationReason.ProblemaChofer;
    private string? cancelDescription;
    private IReadOnlyList<PendingRefundResponse> pendingRefunds = [];

    // Fase D — stop times edit dialog (odd/tasks/mejoras-detalle-viaje.md).
    private bool isEditStopTimesDialogOpen;
    private bool isSavingStopTimes;
    private string? stopTimesErrorMessage;
    private string? stopTimesSubmitErrorMessage;
    private List<StopTimeEditModel> stopTimeEdits = [];

    // CU-04 — send notification dialog + history.
    private static readonly WebNotificationReason[] NotificationReasons = Enum.GetValues<WebNotificationReason>();
    private bool isSendNotificationDialogOpen;
    private bool isSendingNotification;
    private string? sendNotificationErrorMessage;
    private WebNotificationReason notificationReason = WebNotificationReason.CambioHorario;
    private string? notificationMessage;
    private bool notifyWholeEvent;
    private bool isLoadingNotificationHistory;
    private IReadOnlyList<NotificationResponse> notificationHistory = [];

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var outcome = await TripsClient.GetByIdAsync(Id);

            switch (outcome)
            {
                case TripOutcome.Success success:
                    trip = success.Trip;
                    errorMessage = null;
                    break;

                case TripOutcome.NotFound:
                    errorMessage = "No encontramos ese viaje.";
                    break;

                case TripOutcome.Forbidden:
                case TripOutcome.TransportError:
                    errorMessage = "No pudimos cargar el viaje.";
                    break;
            }
        }
        finally
        {
            isLoading = false;
        }

        if (trip is not null)
        {
            await LoadSeatMapAsync();
            await LoadNotificationHistoryAsync();

            if (trip.Status == WebTripStatus.Cancelado)
            {
                await LoadPendingRefundsAsync();
            }

            if (trip.Status == WebTripStatus.Publicado)
            {
                startWindowTimer = new System.Threading.Timer(
                    _ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
            }
        }
    }

    private async Task LoadPendingRefundsAsync()
    {
        var outcome = await TripsClient.GetPendingRefundsAsync(Id);
        if (outcome is TripPendingRefundsOutcome.Success success)
        {
            pendingRefunds = success.Refunds;
        }
    }

    public void Dispose()
    {
        startWindowTimer?.Dispose();
    }

    private async Task HandleStart()
    {
        startErrorMessage = null;
        isStarting = true;
        try
        {
            var outcome = await TripsClient.StartAsync(Id);

            switch (outcome)
            {
                case TripStartOutcome.Success:
                    trip = trip! with { Status = WebTripStatus.EnProceso };
                    startWindowTimer?.Dispose();
                    startWindowTimer = null;
                    Snackbar.Add("Viaje iniciado correctamente.", Severity.Success);
                    break;

                case TripStartOutcome.ValidationFailed validationFailed:
                    startErrorMessage = string.Join(" ", validationFailed.Errors.Values.SelectMany(messages => messages));
                    break;

                case TripStartOutcome.NotFound:
                    startErrorMessage = "No encontramos ese viaje.";
                    break;

                case TripStartOutcome.Forbidden:
                    startErrorMessage = "No tenés permiso para iniciar este viaje.";
                    break;

                case TripStartOutcome.TransportError transportError:
                    startErrorMessage = transportError.Message;
                    break;
            }
        }
        finally
        {
            isStarting = false;
        }
    }

    private void OpenFinishTripDialog()
    {
        isFinishTripDialogOpen = true;
        finishTripErrorMessage = null;
        var now = DateTime.Now;
        finishArrivalDate = now.Date;
        finishArrivalTime = now.TimeOfDay;
        finishObservations = null;
    }

    private void CloseFinishTripDialog()
    {
        isFinishTripDialogOpen = false;
    }

    private async Task ConfirmFinishTripAsync()
    {
        if (finishArrivalDate is null || finishArrivalTime is null)
        {
            finishTripErrorMessage = "Ingresá la fecha y hora de llegada.";
            return;
        }

        finishTripErrorMessage = null;
        isFinishingTrip = true;
        try
        {
            var actualArrivalDate = (finishArrivalDate.Value.Date + finishArrivalTime.Value).ToUniversalTime();
            var outcome = await TripsClient.FinishAsync(
                Id, new FinishTripRequest { ActualArrivalDate = actualArrivalDate, Observations = finishObservations });

            switch (outcome)
            {
                case TripFinishOutcome.Success:
                    trip = trip! with { Status = WebTripStatus.Completado };
                    isFinishTripDialogOpen = false;
                    Snackbar.Add("Viaje finalizado correctamente.", Severity.Success);
                    break;

                case TripFinishOutcome.ValidationFailed validationFailed:
                    finishTripErrorMessage = string.Join(" ", validationFailed.Errors.Values.SelectMany(messages => messages));
                    break;

                case TripFinishOutcome.NotFound:
                    finishTripErrorMessage = "No encontramos ese viaje.";
                    break;

                case TripFinishOutcome.Forbidden:
                    finishTripErrorMessage = "No tenés permiso para finalizar este viaje.";
                    break;

                case TripFinishOutcome.TransportError transportError:
                    finishTripErrorMessage = transportError.Message;
                    break;
            }
        }
        finally
        {
            isFinishingTrip = false;
        }
    }

    private async Task LoadSeatMapAsync()
    {
        isLoadingSeatMap = true;
        try
        {
            var outcome = await TripsClient.GetSeatMapAsync(Id);

            switch (outcome)
            {
                case TripSeatMapOutcome.Success success:
                    seatMap = success.SeatMap;
                    seatMapErrorMessage = null;
                    seatRows = SeatGridLayout.BuildSeatRows(success.SeatMap.Capacity);
