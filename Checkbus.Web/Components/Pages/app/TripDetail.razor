                    seatMapErrorMessage = "No tenés permiso para ver el mapa de asientos de este viaje.";
                    break;

                case TripSeatMapOutcome.TransportError transportError:
                    seatMapErrorMessage = transportError.Message;
                    break;
            }
        }
        finally
        {
            isLoadingSeatMap = false;
        }
    }

    private void OpenEditStopTimesDialog()
    {
        if (trip is null)
        {
            return;
        }

        stopTimesSubmitErrorMessage = null;
        stopTimeEdits = trip.Route.Stops
            .OrderBy(s => s.Order)
            .Select(s => new StopTimeEditModel
            {
                StopId = s.Id,
                Order = s.Order,
                Name = s.Name,
                Date = s.DepartureTime?.Date,
                Time = s.DepartureTime?.TimeOfDay
            })
            .ToList();

        isEditStopTimesDialogOpen = true;
    }

    private void CloseEditStopTimesDialog()
    {
        isEditStopTimesDialogOpen = false;
    }

    private async Task SaveStopTimesAsync()
    {
        stopTimesSubmitErrorMessage = null;

        if (stopTimeEdits.Any(s => s.Date is null || s.Time is null))
        {
            stopTimesSubmitErrorMessage = "Completá la fecha y la hora de cada parada.";
            return;
        }

        isSavingStopTimes = true;
        try
        {
            var request = new UpdateStopTimesRequest
            {
                Stops = stopTimeEdits
                    .Select(s => new StopDepartureTimeRequest
                    {
                        StopId = s.StopId,
                        DepartureTime = s.Date!.Value.Date + s.Time!.Value
                    })
                    .ToList()
            };

            var outcome = await TripsClient.UpdateStopTimesAsync(Id, request);

            switch (outcome)
            {
                case TripStopTimesUpdateOutcome.Success:
                    isEditStopTimesDialogOpen = false;
                    stopTimesErrorMessage = null;
                    Snackbar.Add("Horarios actualizados correctamente.", Severity.Success);
                    // Re-fetch so the Paradas list reflects the saved values.
                    var refreshed = await TripsClient.GetByIdAsync(Id);
                    if (refreshed is TripOutcome.Success refreshedSuccess)
                    {
                        trip = refreshedSuccess.Trip;
                    }
                    break;

                case TripStopTimesUpdateOutcome.ValidationFailed validationFailed:
                    stopTimesSubmitErrorMessage = string.Join(" ", validationFailed.Errors.Values.SelectMany(messages => messages));
                    break;

                case TripStopTimesUpdateOutcome.NotFound:
                    stopTimesSubmitErrorMessage = "No encontramos ese viaje o alguna de sus paradas.";
                    break;

                case TripStopTimesUpdateOutcome.Forbidden:
                    stopTimesSubmitErrorMessage = "No tenés permiso para editar los horarios de este viaje.";
                    break;

                case TripStopTimesUpdateOutcome.TransportError transportError:
                    stopTimesSubmitErrorMessage = transportError.Message;
                    break;
            }
        }
        finally
        {
            isSavingStopTimes = false;
        }
    }

    private sealed class StopTimeEditModel
    {
        public Guid StopId { get; set; }
        public int Order { get; set; }
        public required string Name { get; set; }
        public DateTime? Date { get; set; }
        public TimeSpan? Time { get; set; }
    }

    private async Task CopyPublicUrlToClipboard()
    {
        // navigator.clipboard is a built-in browser API — invoked directly via IJSRuntime
        // rather than adding a new .js interop module for a single one-line call.
        await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", PublicReservationUrl);
        Snackbar.Add("Link copiado.", Severity.Success);
    }

    private async Task HandlePublish()
    {
        publishErrorMessage = null;
        isPublishing = true;
        try
        {
            var outcome = await TripsClient.PublishAsync(Id);

            switch (outcome)
            {
                case TripPublishOutcome.Success:
                    // Flip locally rather than re-fetching — the only field this action changes
                    // is Status, and we already have the rest of the detail loaded.
                    trip = trip! with { Status = WebTripStatus.Publicado };
                    Snackbar.Add("Viaje publicado correctamente.", Severity.Success);
                    break;

                case TripPublishOutcome.ValidationFailed validationFailed:
                    publishErrorMessage = string.Join(" ", validationFailed.Errors.Values.SelectMany(messages => messages));
                    break;

                case TripPublishOutcome.NotFound:
                    publishErrorMessage = "No encontramos ese viaje.";
                    break;

                case TripPublishOutcome.Forbidden:
                    publishErrorMessage = "No tenés permiso para publicar este viaje.";
                    break;

                case TripPublishOutcome.TransportError transportError:
                    publishErrorMessage = transportError.Message;
                    break;
            }
        }
        finally
        {
            isPublishing = false;
        }
    }

    private void OpenCancelTripDialog()
    {
        isCancelTripDialogOpen = true;
        isCancelTripConfirmationStep = false;
        cancelTripErrorMessage = null;
        cancelReason = WebTripCancellationReason.ProblemaChofer;
        cancelDescription = null;
    }

    private void CloseCancelTripDialog()
    {
        isCancelTripDialogOpen = false;
    }

    private void ContinueToCancelConfirmation()
    {
        if (cancelReason == WebTripCancellationReason.Otro && string.IsNullOrWhiteSpace(cancelDescription))
        {
            cancelTripErrorMessage = "Ingresá una descripción para el motivo \"Otro\".";
            return;
        }

        cancelTripErrorMessage = null;
        isCancelTripConfirmationStep = true;
    }

    private async Task ConfirmCancelTripAsync()
    {
        cancelTripErrorMessage = null;
        isCancellingTrip = true;
        try
        {
            var outcome = await TripsClient.CancelAsync(
                Id, new CancelTripRequest { Reason = cancelReason, Description = cancelDescription });

            switch (outcome)
            {
                case TripCancelOutcome.Success:
                    trip = trip! with { Status = WebTripStatus.Cancelado };
                    isCancelTripDialogOpen = false;
                    Snackbar.Add("Viaje cancelado correctamente.", Severity.Success);
                    await LoadPendingRefundsAsync();
                    break;

                case TripCancelOutcome.ValidationFailed validationFailed:
                    cancelTripErrorMessage = string.Join(" ", validationFailed.Errors.Values.SelectMany(messages => messages));
                    break;

                case TripCancelOutcome.NotFound:
                    cancelTripErrorMessage = "No encontramos ese viaje.";
                    break;

                case TripCancelOutcome.Forbidden:
                    cancelTripErrorMessage = "No tenés permiso para cancelar este viaje.";
                    break;

                case TripCancelOutcome.TransportError transportError:
                    cancelTripErrorMessage = transportError.Message;
                    break;
            }
        }
        finally
        {
            isCancellingTrip = false;
        }
    }

    private void OpenSendNotificationDialog()
    {
        isSendNotificationDialogOpen = true;
        sendNotificationErrorMessage = null;
        notificationReason = WebNotificationReason.CambioHorario;
        notificationMessage = null;
        notifyWholeEvent = false;
    }

    private void CloseSendNotificationDialog()
    {
        isSendNotificationDialogOpen = false;
    }

    private async Task ConfirmSendNotificationAsync()
    {
        if (string.IsNullOrWhiteSpace(notificationMessage))
        {
            sendNotificationErrorMessage = "Ingresá un mensaje.";
            return;
        }

        sendNotificationErrorMessage = null;
        isSendingNotification = true;
        try
        {
            var request = new CreateNotificationRequest
            {
                TargetType = notifyWholeEvent ? WebNotificationTargetType.Event : WebNotificationTargetType.Trip,
                TargetId = notifyWholeEvent ? trip!.EventId : trip!.Id,
                Reason = notificationReason,
                Message = notificationMessage
            };

            var outcome = await NotificationsClient.CreateAsync(request);

            switch (outcome)
            {
                case NotificationCreateOutcome.Success:
                    isSendNotificationDialogOpen = false;
                    Snackbar.Add("Notificación enviada correctamente.", Severity.Success);
                    await LoadNotificationHistoryAsync();
                    break;

                case NotificationCreateOutcome.ValidationFailed validationFailed:
                    sendNotificationErrorMessage = string.Join(" ", validationFailed.Errors.Values.SelectMany(messages => messages));
                    break;

                case NotificationCreateOutcome.NotFound:
                    sendNotificationErrorMessage = "No encontramos el destino de la notificación.";
                    break;

                case NotificationCreateOutcome.Forbidden:
                    sendNotificationErrorMessage = "No tenés permiso para enviar esta notificación.";
                    break;

                case NotificationCreateOutcome.TransportError transportError:
                    sendNotificationErrorMessage = transportError.Message;
                    break;
            }
        }
        finally
        {
            isSendingNotification = false;
        }
    }

    private async Task LoadNotificationHistoryAsync()
    {
        isLoadingNotificationHistory = true;
        try
        {
            var outcome = await NotificationsClient.GetTripHistoryAsync(Id);
            if (outcome is NotificationHistoryOutcome.Success success)
            {
                notificationHistory = success.Notifications;
            }
        }
        finally
        {
            isLoadingNotificationHistory = false;
        }
    }

