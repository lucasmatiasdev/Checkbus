@page "/trips"
@attribute [Authorize(Roles = "Planificador,Administrador")]
@using Checkbus.Web.Contracts
@using Checkbus.Web.Services

<PageTitle>Checkbus - Viajes</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
        <MudText Typo="Typo.h4" Color="Color.Secondary" Class="font-weight-bold">
            Viajes
        </MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.DirectionsBus"
                   OnClick="@(() => NavigationManager.NavigateTo("/trips/new"))">
            Nuevo viaje
        </MudButton>
    </MudStack>

    @if (errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
    }

    <MudPaper Elevation="2" Class="pa-6">
        @if (isLoading)
        {
            <MudProgressCircular Indeterminate="true" Class="my-4" />
        }
        else
        {
            <MudDataGrid T="TripResponse" Items="@trips" RowClick="@HandleRowClick">
                <Columns>
                    <TemplateColumn Title="Evento">
                        <CellTemplate>
                            @(context.Item.EventName ?? "-")
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Vehículo">
                        <CellTemplate>
                            @(context.Item.VehiclePatent is null
                                ? "-"
                                : $"{context.Item.VehiclePatent} ({context.Item.VehicleBrand} {context.Item.VehicleModel})")
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Chofer">
                        <CellTemplate>
                            @(context.Item.DriverName is null ? "-" : $"{context.Item.DriverName} {context.Item.DriverSurname}")
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Salida">
                        <CellTemplate>
                            @context.Item.DepartureDate.ToString("dd/MM/yyyy HH:mm")
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Llegada">
                        <CellTemplate>
                            @context.Item.ArrivalDate.ToString("dd/MM/yyyy HH:mm")
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Estado">
                        <CellTemplate>
                            @GetStatusLabel(context.Item.Status)
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Precio">
                        <CellTemplate>
                            @context.Item.Price.ToString("C")
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        }
    </MudPaper>
</MudContainer>

@code {
    [Inject]
    private TripsClient TripsClient { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private IReadOnlyList<TripResponse> trips = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var outcome = await TripsClient.GetListAsync();

            switch (outcome)
            {
                case TripsListOutcome.Success success:
                    trips = success.Trips;
                    errorMessage = null;
                    break;

                case TripsListOutcome.Forbidden:
                case TripsListOutcome.TransportError:
                    errorMessage = "No pudimos cargar los viajes.";
                    break;
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void HandleRowClick(DataGridRowClickEventArgs<TripResponse> args)
    {
        NavigationManager.NavigateTo($"/trips/{args.Item.Id}");
    }

    private static string GetStatusLabel(WebTripStatus status) => status switch
    {
        WebTripStatus.Programado => "Programado",
        WebTripStatus.EnProceso => "En proceso",
        WebTripStatus.Completado => "Completado",
        WebTripStatus.Cancelado => "Cancelado",
        _ => status.ToString()
    };
}
