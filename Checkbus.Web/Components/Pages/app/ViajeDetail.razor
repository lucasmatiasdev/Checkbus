@page "/viajes/{id:guid}"
@attribute [Authorize(Roles = "Planificador,Administrador")]
@using Checkbus.Web.Contracts
@using Checkbus.Web.Services

<PageTitle>Checkbus - Detalle de viaje</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Class="my-4" />
    }
    else if (errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }
    else if (viaje is not null)
    {
        <MudText Typo="Typo.h4" Color="Color.Secondary" Class="font-weight-bold mb-6">
            Viaje a @viaje.EventoNombre
        </MudText>

        <MudPaper Elevation="2" Class="pa-6 mb-6">
            <MudText Typo="Typo.h6" Class="mb-4">Datos del viaje</MudText>
            <MudGrid>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Vehículo</MudText>
                    <MudText Typo="Typo.body1">@($"{viaje.VehiclePatent} ({viaje.VehicleBrand} {viaje.VehicleModel})")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Chofer</MudText>
                    <MudText Typo="Typo.body1">@($"{viaje.ChoferName} {viaje.ChoferSurname}")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Salida</MudText>
                    <MudText Typo="Typo.body1">@viaje.FechaSalida.ToString("dd/MM/yyyy HH:mm")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Llegada</MudText>
                    <MudText Typo="Typo.body1">@viaje.FechaLlegada.ToString("dd/MM/yyyy HH:mm")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Estado</MudText>
                    <MudText Typo="Typo.body1">@GetEstadoLabel(viaje.Estado)</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Precio</MudText>
                    <MudText Typo="Typo.body1">@viaje.Precio.ToString("C")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Capacidad</MudText>
                    <MudText Typo="Typo.body1">@viaje.Capacidad</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Asientos disponibles</MudText>
                    <MudText Typo="Typo.body1">@viaje.AsientosDisponibles</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="2" Class="pa-6">
            <MudText Typo="Typo.h6" Class="mb-2">Ruta</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                @viaje.Ruta.DistanciaKm.ToString("0.#") km · @viaje.Ruta.TiempoEstimado.ToString(@"hh\:mm")
            </MudText>

            <MudList T="StopResponse" Dense="true">
                @foreach (var stop in viaje.Ruta.Stops.OrderBy(s => s.Orden))
                {
                    <MudListItem T="StopResponse">
                        <MudText Typo="Typo.body1">@(stop.Orden + 1). @GetTipoLabel(stop.Tipo) — @stop.Nombre</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@stop.Direccion</MudText>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter]
    public Guid Id { get; set; }

    [Inject]
    private ViajesClient ViajesClient { get; set; } = default!;

    private ViajeDetailResponse? viaje;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var outcome = await ViajesClient.GetByIdAsync(Id);

            switch (outcome)
            {
                case ViajeOutcome.Success success:
                    viaje = success.Viaje;
                    errorMessage = null;
                    break;

                case ViajeOutcome.NotFound:
                    errorMessage = "No encontramos ese viaje.";
                    break;

                case ViajeOutcome.Forbidden:
                case ViajeOutcome.TransportError:
                    errorMessage = "No pudimos cargar el viaje.";
                    break;
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetEstadoLabel(WebViajeEstado estado) => estado switch
    {
        WebViajeEstado.Programado => "Programado",
        WebViajeEstado.EnProceso => "En proceso",
        WebViajeEstado.Completado => "Completado",
        WebViajeEstado.Cancelado => "Cancelado",
        _ => estado.ToString()
    };

    private static string GetTipoLabel(WebStopTipo tipo) => tipo switch
    {
        WebStopTipo.Origen => "Origen",
        WebStopTipo.Intermedia => "Parada",
        WebStopTipo.Destino => "Destino",
        _ => tipo.ToString()
    };
}
